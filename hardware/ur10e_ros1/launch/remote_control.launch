<launch>
  <arg name="robot_ip" default="192.168.0.123"/>
  <arg name="reverse_ip" default="192.168.0.1"/>
  <arg name="calibration"/>
  <include file="$(find ur_robot_driver)/launch/ur10e_bringup.launch">
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="reverse_ip" value="$(arg reverse_ip)"/>
    <arg name="kinematics_config" value="$(arg calibration)"/>
    <arg name="robot_description_file" value="$(dirname)/description.launch"/>
    <arg name="headless_mode" value="true"/>
    <arg name="controllers" value="joint_state_controller speed_scaling_state_controller force_torque_sensor_controller"/>
    <arg name="stopped_controllers" value="scaled_pos_joint_traj_controller"/>
  </include>
  <rosparam command="load" file="$(dirname)/../config/fdcc_native.yaml"/>
  <node pkg="controller_manager" type="spawner" name="fdcc_shared_loader"
        args="--stopped fdcc_shared" output="screen"/>
</launch>
