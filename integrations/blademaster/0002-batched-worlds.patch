+@wp.kernel
+def load_external_state(enabled: wp.array(dtype=int), packed: wp.array(dtype=float, ndim=2), tool_pos: wp.array(dtype=wp.vec3, ndim=2), tool_rot: wp.array(dtype=wp.quat, ndim=2), tool_vel: wp.array(dtype=wp.vec3, ndim=2), tool_omega: wp.array(dtype=wp.vec3, ndim=2), mobility: wp.array(dtype=float, ndim=3), linear: wp.array(dtype=wp.vec3, ndim=2), angular: wp.array(dtype=wp.vec3, ndim=2)):
+    world, _batch_tid0 = wp.tid()
