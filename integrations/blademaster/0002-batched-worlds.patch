+    for i in range(4):
+        out[world, offset + 3 + i] = rotation[world, 0][i]
+
+@wp.kernel
+def store_interval(enabled: wp.array(dtype=int), linear: wp.array(dtype=wp.vec3, ndim=2), angular: wp.array(dtype=wp.vec3, ndim=2), errors: wp.array(dtype=int, ndim=2), out: wp.array(dtype=float, ndim=2)):
+    world, _batch_tid0 = wp.tid()
