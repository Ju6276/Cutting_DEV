+    if enabled[i // count] != 0:
+        dst[i] = value
+
+
+@wp.kernel
+def masked_copy(src: wp.array(dtype=Any), dst: wp.array(dtype=Any), enabled: wp.array(dtype=int), count: int):
+    i = wp.tid()
+    if enabled[i // count] != 0:
+        dst[i] = src[i]
+
+
