+    angular[world, 0] = wp.vec3(0.0)
+
+@wp.kernel
+def record_pose(enabled: wp.array(dtype=int), position: wp.array(dtype=wp.vec3, ndim=2), rotation: wp.array(dtype=wp.quat, ndim=2), index: int, out: wp.array(dtype=float, ndim=2)):
+    world, _batch_tid0 = wp.tid()
