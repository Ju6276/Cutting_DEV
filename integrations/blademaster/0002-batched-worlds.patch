+@wp.kernel
+def update_F_plastic(enabled: wp.array(dtype=int), F: wp.array(dtype=wp.mat33, ndim=2), Fp: wp.array(dtype=wp.mat33, ndim=2), slots: wp.array(dtype=int, ndim=3), gradients: wp.array(dtype=wp.vec3, ndim=3), grid_mass: wp.array(dtype=float, ndim=2), momentum: wp.array(dtype=wp.vec3, ndim=2), dt: float, mu: float, lam: float, yield_stress: float, stress: wp.array(dtype=wp.mat33, ndim=2), errors: wp.array(dtype=int, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    'MUSL deformation update, plastic projection, and the stress for the next step.'
+    p = _batch_tid0
+    rate = wp.mat33(0.0)
+    for a in range(8):
+        s = slots[world, p, a]
+        if grid_mass[world, s] > 0.0:
+            rate += wp.outer(momentum[world, s] / grid_mass[world, s], gradients[world, p, a])
+    F[world, p] += dt * rate
+    if yield_stress > 0.0:
+        U, sigma, V, valid = plastic_at(world, p, F, Fp, mu, yield_stress, errors)
+        if valid:
+            plastic_inverse = wp.inverse(Fp[world, p])
+            stress[world, p] = corotated_stress(F[world, p] * plastic_inverse, U, V, plastic_inverse, mu, lam)
+        else:
+            stress[world, p] = wp.mat33(0.0)
+    else:
+        stress_at(world, p, F, Fp, mu, lam, stress, errors)
+
+@wp.func
+def expm1(x: float):
+    if wp.abs(x) < 0.001:
+        return x * (1.0 + 0.5 * x * (1.0 + x / 3.0))
+    return wp.exp(x) - 1.0
+
+@wp.func
+def maxwell_at(world: int, p: int, U: wp.mat33, sigma: wp.vec3, V: wp.mat33, F: wp.array(dtype=wp.mat33, ndim=2), Fp: wp.array(dtype=wp.mat33, ndim=2), viscous: wp.array(dtype=wp.mat33d, ndim=2), mu: float, lam: float, mu_maxwell: float, relax: float, stress: wp.array(dtype=wp.mat33, ndim=2), errors: wp.array(dtype=int, ndim=2)):
+    """Generalized standard linear solid on the elastic deformation f = U diag(sigma) V^T = F Fp^-1.
+
+    Equilibrium branch: fixed corotated with mu - mu_maxwell and lam + 2/3 mu_maxwell, so
+    the instantaneous small-strain shear and bulk moduli equal those of (mu, lam).
+    Maxwell branch: f_m = f Fv^-1 with Fv = I + viscous[p], Kirchhoff stress
+    2 mu_maxwell dev(log V_m). Its deviatoric Hencky strain is reduced by the factor
+    relax = 1 - exp(-dt/tau) (exact for a held strain, stable for any dt/tau); the update of
+    Fv is isochoric, so the branch carries no volumetric stress. relax = 0 only evaluates
+    the stress. The increment (dt/tau) * strain is far below the float32 resolution of Fv,
+    so Fv - I is accumulated in float64.
+    """
+    f = U * wp.diag(sigma) * wp.transpose(V)
+    D = viscous[world, p]
+    fm = f * wp.inverse(wp.identity(n=3, dtype=float) + wp.mat33(D))
+    Um, sm, Vm = wp.svd3(fm)
+    if wp.min(sm) <= 0.0:
+        wp.atomic_add(errors, world, 1, 1)
+        stress[world, p] = wp.mat33(0.0)
+        return
+    e = wp.vec3(wp.log(sm[0]), wp.log(sm[1]), wp.log(sm[2]))
+    dev = e - wp.vec3((e[0] + e[1] + e[2]) / 3.0)
+    if relax > 0.0:
+        step = relax * dev
+        dev = dev - step
+        growth = wp.vec3(expm1(step[0]), expm1(step[1]), expm1(step[2]))
+        delta = wp.mat33d(Vm * wp.diag(growth) * wp.transpose(Vm))
+        viscous[world, p] = D + delta + delta * D
+    kirchhoff = Um * wp.diag(2.0 * mu_maxwell * dev) * wp.transpose(Um)
+    mu_eq = mu - mu_maxwell
+    lam_eq = lam + 2.0 / 3.0 * mu_maxwell
+    equilibrium = corotated_stress(f, U, V, wp.inverse(Fp[world, p]), mu_eq, lam_eq)
+    stress[world, p] = equilibrium + kirchhoff * wp.transpose(wp.inverse(F[world, p]))
+
+@wp.func
+def maxwell_stress_at(world: int, p: int, F: wp.array(dtype=wp.mat33, ndim=2), Fp: wp.array(dtype=wp.mat33, ndim=2), viscous: wp.array(dtype=wp.mat33d, ndim=2), mu: float, lam: float, mu_maxwell: float, relax: float, yield_stress: float, stress: wp.array(dtype=wp.mat33, ndim=2), errors: wp.array(dtype=int, ndim=2)):
+    if yield_stress > 0.0:
+        U, sigma, V, valid = plastic_at(world, p, F, Fp, mu, yield_stress, errors)
+        if not valid:
+            stress[world, p] = wp.mat33(0.0)
+            return
+        maxwell_at(world, p, U, sigma, V, F, Fp, viscous, mu, lam, mu_maxwell, relax, stress, errors)
+    else:
+        f = F[world, p] * wp.inverse(Fp[world, p])
+        J = wp.determinant(f)
+        if J <= 0.0 or not wp.isfinite(J):
+            wp.atomic_add(errors, world, 1, 1)
+            stress[world, p] = wp.mat33(0.0)
+            return
+        U, sigma, V = wp.svd3(f)
+        maxwell_at(world, p, U, sigma, V, F, Fp, viscous, mu, lam, mu_maxwell, relax, stress, errors)
+
+@wp.kernel
+def compute_stress_maxwell(enabled: wp.array(dtype=int), F: wp.array(dtype=wp.mat33, ndim=2), Fp: wp.array(dtype=wp.mat33, ndim=2), viscous: wp.array(dtype=wp.mat33d, ndim=2), mu: float, lam: float, mu_maxwell: float, stress: wp.array(dtype=wp.mat33, ndim=2), errors: wp.array(dtype=int, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    'Stress of the current F, Fp, Fv without plastic projection or relaxation.'
+    p = _batch_tid0
+    f = F[world, p] * wp.inverse(Fp[world, p])
+    J = wp.determinant(f)
+    if J <= 0.0 or not wp.isfinite(J):
+        wp.atomic_add(errors, world, 1, 1)
+        stress[world, p] = wp.mat33(0.0)
+        return
+    U, sigma, V = wp.svd3(f)
+    maxwell_at(world, p, U, sigma, V, F, Fp, viscous, mu, lam, mu_maxwell, 0.0, stress, errors)
+
+@wp.kernel
+def update_F_maxwell(enabled: wp.array(dtype=int), F: wp.array(dtype=wp.mat33, ndim=2), Fp: wp.array(dtype=wp.mat33, ndim=2), viscous: wp.array(dtype=wp.mat33d, ndim=2), slots: wp.array(dtype=int, ndim=3), gradients: wp.array(dtype=wp.vec3, ndim=3), grid_mass: wp.array(dtype=float, ndim=2), momentum: wp.array(dtype=wp.vec3, ndim=2), dt: float, mu: float, lam: float, mu_maxwell: float, relax: float, yield_stress: float, stress: wp.array(dtype=wp.mat33, ndim=2), errors: wp.array(dtype=int, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    'update_F_plastic followed by relaxation of the Maxwell branch.'
+    p = _batch_tid0
+    rate = wp.mat33(0.0)
+    for a in range(8):
+        s = slots[world, p, a]
+        if grid_mass[world, s] > 0.0:
+            rate += wp.outer(momentum[world, s] / grid_mass[world, s], gradients[world, p, a])
+    F[world, p] += dt * rate
+    maxwell_stress_at(world, p, F, Fp, viscous, mu, lam, mu_maxwell, relax, yield_stress, stress, errors)
+
+@wp.kernel
+def compact_keys(enabled: wp.array(dtype=int), keys: wp.array(dtype=wp.int64, ndim=2), mapping: wp.array(dtype=int, ndim=2), packed: wp.array(dtype=wp.int64, ndim=2), count: wp.array(dtype=int, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    h = _batch_tid0
+    if keys[world, h] >= wp.int64(0):
+        a = wp.atomic_add(count, world, 0, 1)
+        mapping[world, h] = a
+        packed[world, a] = keys[world, h]
+
+@wp.kernel
+def remap_slots(enabled: wp.array(dtype=int), slots: wp.array(dtype=int, ndim=3), mapping: wp.array(dtype=int, ndim=2)):
+    world, _batch_tid0, _batch_tid1 = wp.tid()
+    if enabled[world] == 0:
+        return
+    p, a = (_batch_tid0, _batch_tid1)
+    if slots[world, p, a] >= 0:
+        slots[world, p, a] = mapping[world, slots[world, p, a]]
+
+@wp.kernel
+def compact_node_lists(enabled: wp.array(dtype=int), count: wp.array(dtype=int, ndim=2), threads: int, keys: wp.array(dtype=wp.int64, ndim=2), heads: wp.array(dtype=int, ndim=2), links: wp.array(dtype=int, ndim=2), node_count: int):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    for a in range(_batch_tid0, count[world, 0], threads):
+        node = int(keys[world, a] % wp.int64(node_count))
+        links[world, a] = wp.atomic_exch(heads, world, node, a)
+
+@wp.kernel
+def clear_compact_grid(enabled: wp.array(dtype=int), count: wp.array(dtype=int, ndim=2), threads: int, grid_mass: wp.array(dtype=float, ndim=2), momentum: wp.array(dtype=wp.vec3, ndim=2), impulse: wp.array(dtype=wp.vec3, ndim=2), remapped: wp.array(dtype=wp.vec3, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    for a in range(_batch_tid0, count[world, 0], threads):
+        grid_mass[world, a] = 0.0
+        momentum[world, a] = wp.vec3(0.0)
+        impulse[world, a] = wp.vec3(0.0)
+        remapped[world, a] = wp.vec3(0.0)
