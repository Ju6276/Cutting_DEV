+# Generated by generate_batch_kernels.py; physics expressions retained.
+"""Rigid knife drive, knife/board contact and external-tool step finalization."""
+import warp as wp
+
+@wp.kernel
+def accumulate_reaction(enabled: wp.array(dtype=int), reaction: wp.array(dtype=wp.vec3, ndim=2), torque: wp.array(dtype=wp.vec3, ndim=2), position: wp.array(dtype=wp.vec3, ndim=2), linear: wp.array(dtype=wp.vec3, ndim=2), angular: wp.array(dtype=wp.vec3, ndim=2)):
