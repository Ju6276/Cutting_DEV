+# Generated by generate_batch_kernels.py; physics expressions retained.
+"""Prevent grid transport through the broad faces of an externally held blade.
+
+The original penalty, friction and cutting-work laws run first. The velocity
+solve uses W = N^T M^-1 C N with the solver's compatible-field exchange and does
+not add restitution. The external body's pose is fixed during these material
+substeps; its measured mobility and the returned reaction remain in the original
+coupling.
+"""
+import warp as wp
+
+@wp.func
+def prepare_at(world: int, p: int, x: wp.array(dtype=wp.vec3, ndim=2), slots: wp.array(dtype=int, ndim=3), weights: wp.array(dtype=float, ndim=3), velocity: wp.array(dtype=wp.vec3, ndim=2), position: wp.array(dtype=wp.vec3, ndim=2), rotation: wp.array(dtype=wp.quat, ndim=2), half: wp.vec3, bevel: float, radius: float, dt: float, tool_velocity: wp.vec3, tool_omega: wp.vec3, side: wp.array(dtype=float, ndim=2), normal: wp.array(dtype=wp.vec3, ndim=2), lever: wp.array(dtype=wp.vec3, ndim=2), rhs: wp.array(dtype=float, ndim=2), active_weights: wp.array(dtype=wp.vec3, ndim=2), impulse: wp.array(dtype=float, ndim=2), extrapolated: wp.array(dtype=float, ndim=2), needs_solve: wp.array(dtype=int, ndim=2)):
+    local = wp.quat_rotate_inv(rotation[world, 0], x[world, p] - position[world, 0])
+    normal[world, p] = wp.vec3(0.0)
+    impulse[world, p] = 0.0
+    extrapolated[world, p] = 0.0
+    if wp.abs(local[1]) >= half[1] or local[2] <= -half[2] + bevel or local[2] >= half[2]:
+        side[world, p] = 0.0
+        return
+    grid_v = wp.vec3(0.0)
+    for a in range(8):
+        slot = slots[world, p, a]
+        if slot >= 0:
+            grid_v += weights[world, p, a] * velocity[world, slot]
+    s = side[world, p]
+    if s == 0.0 or wp.abs(local[0]) > half[0] + radius:
+        s = 1.0
+        if local[0] < 0.0:
+            s = -1.0
+    n = wp.quat_rotate(rotation[world, 0], wp.vec3(s, 0.0, 0.0))
+    gap = s * local[0] - half[0]
+    arm = wp.quat_rotate(rotation[world, 0], wp.vec3(s * half[0], local[1], local[2]))
+    relative = grid_v - tool_velocity - wp.cross(tool_omega, arm)
+    if gap > radius and gap + dt * wp.dot(relative, n) > 0.0:
+        side[world, p] = 0.0
+        return
+    side[world, p] = s
+    normal[world, p] = n
+    lever[world, p] = arm
+    rhs[world, p] = -wp.max(gap, 0.0) / dt - wp.dot(relative, n)
+    for a in range(8):
+        slot = slots[world, p, a]
+        if slot >= 0:
+            wp.atomic_add(active_weights, world, slot, wp.vec3(weights[world, p, a], 0.0, 0.0))
+    if rhs[world, p] > 1e-07:
+        wp.atomic_max(needs_solve, world, 0, 1)
+
+@wp.kernel
+def prepare(enabled: wp.array(dtype=int), x: wp.array(dtype=wp.vec3, ndim=2), slots: wp.array(dtype=int, ndim=3), weights: wp.array(dtype=float, ndim=3), velocity: wp.array(dtype=wp.vec3, ndim=2), position: wp.array(dtype=wp.vec3, ndim=2), rotation: wp.array(dtype=wp.quat, ndim=2), half: wp.vec3, bevel: float, radius: float, dt: float, side: wp.array(dtype=float, ndim=2), normal: wp.array(dtype=wp.vec3, ndim=2), lever: wp.array(dtype=wp.vec3, ndim=2), rhs: wp.array(dtype=float, ndim=2), active_weights: wp.array(dtype=wp.vec3, ndim=2), impulse: wp.array(dtype=float, ndim=2), extrapolated: wp.array(dtype=float, ndim=2), needs_solve: wp.array(dtype=int, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    prepare_at(world, _batch_tid0, x, slots, weights, velocity, position, rotation, half, bevel, radius, dt, wp.vec3(0.0), wp.vec3(0.0), side, normal, lever, rhs, active_weights, impulse, extrapolated, needs_solve)
+
+@wp.kernel
+def row_bound(enabled: wp.array(dtype=int), slots: wp.array(dtype=int, ndim=3), weights: wp.array(dtype=float, ndim=3), mass: wp.array(dtype=float, ndim=2), coupled_count: wp.array(dtype=wp.vec3, ndim=2), bound: wp.array(dtype=float, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    p = _batch_tid0
+    total = 0.0
+    for a in range(8):
+        s = slots[world, p, a]
+        if s >= 0 and mass[world, s] > 0.0:
+            total += weights[world, p, a] * coupled_count[world, s][0] / mass[world, s]
+    bound[world, p] = total
+
+@wp.kernel
+def scatter(enabled: wp.array(dtype=int), slots: wp.array(dtype=int, ndim=3), weights: wp.array(dtype=float, ndim=3), normal: wp.array(dtype=wp.vec3, ndim=2), lever: wp.array(dtype=wp.vec3, ndim=2), impulse: wp.array(dtype=float, ndim=2), grid: wp.array(dtype=wp.vec3, ndim=2), linear: wp.array(dtype=wp.vec3, ndim=2), angular: wp.array(dtype=wp.vec3, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    p = _batch_tid0
+    j = impulse[world, p] * normal[world, p]
+    for a in range(8):
+        s = slots[world, p, a]
+        if s >= 0:
+            wp.atomic_add(grid, world, s, weights[world, p, a] * j)
+    wp.atomic_add(linear, world, 0, j)
+    wp.atomic_add(angular, world, 0, wp.cross(lever[world, p], j))
+
+@wp.func
+def response_at(world: int, p: int, slots: wp.array(dtype=int, ndim=3), weights: wp.array(dtype=float, ndim=3), mass: wp.array(dtype=float, ndim=2), coupled: wp.array(dtype=wp.vec3, ndim=2)):
+    response = wp.vec3(0.0)
+    for a in range(8):
+        s = slots[world, p, a]
+        if s >= 0 and mass[world, s] > 0.0:
+            response += weights[world, p, a] * coupled[world, s] / mass[world, s]
+    return response
+
+@wp.kernel
+def project(enabled: wp.array(dtype=int), slots: wp.array(dtype=int, ndim=3), weights: wp.array(dtype=float, ndim=3), mass: wp.array(dtype=float, ndim=2), coupled: wp.array(dtype=wp.vec3, ndim=2), normal: wp.array(dtype=wp.vec3, ndim=2), rhs: wp.array(dtype=float, ndim=2), bound: wp.array(dtype=float, ndim=2), impulse: wp.array(dtype=float, ndim=2), extrapolated: wp.array(dtype=float, ndim=2), acceleration: float):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    p = _batch_tid0
+    if wp.length_sq(normal[world, p]) == 0.0:
+        return
+    response = response_at(world, p, slots, weights, mass, coupled)
+    previous = impulse[world, p]
+    current = wp.max(0.0, extrapolated[world, p] + (rhs[world, p] - wp.dot(normal[world, p], response)) / wp.max(bound[world, p], 1e-12))
+    impulse[world, p] = current
+    extrapolated[world, p] = current + acceleration * (current - previous)
+
+@wp.kernel
+def record_residual(enabled: wp.array(dtype=int), slots: wp.array(dtype=int, ndim=3), weights: wp.array(dtype=float, ndim=3), mass: wp.array(dtype=float, ndim=2), coupled: wp.array(dtype=wp.vec3, ndim=2), normal: wp.array(dtype=wp.vec3, ndim=2), rhs: wp.array(dtype=float, ndim=2), maximum: wp.array(dtype=float, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    p = _batch_tid0
+    if wp.length_sq(normal[world, p]) > 0.0:
+        response = response_at(world, p, slots, weights, mass, coupled)
+        wp.atomic_max(maximum, world, 0, wp.max(0.0, rhs[world, p] - wp.dot(normal[world, p], response)))
+
+@wp.kernel
+def finish_refinement(enabled: wp.array(dtype=int), residual: wp.array(dtype=float, ndim=2), batches: wp.array(dtype=int, ndim=2), refine: wp.array(dtype=int, ndim=2), maximum: wp.array(dtype=float, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    batches[world, 0] += 1
+    refine[world, 0] = 0
+    if residual[world, 0] > 1e-06 and batches[world, 0] < 8:
+        refine[world, 0] = 1
+    else:
+        wp.atomic_max(maximum, world, 0, residual[world, 0])
+
+@wp.kernel
+def apply_grid(enabled: wp.array(dtype=int), mass: wp.array(dtype=float, ndim=2), coupled: wp.array(dtype=wp.vec3, ndim=2), velocity: wp.array(dtype=wp.vec3, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    s = _batch_tid0
+    if mass[world, s] > 0.0:
+        velocity[world, s] += coupled[world, s] / mass[world, s]
+
+@wp.kernel
+def add_constraint_part(enabled: wp.array(dtype=int), linear: wp.array(dtype=wp.vec3, ndim=2), parts: wp.array(dtype=wp.vec3, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    parts[world, 3] = parts[world, 3] - linear[world, 0]
+
+@wp.kernel
+def apply_reaction(enabled: wp.array(dtype=int), linear: wp.array(dtype=wp.vec3, ndim=2), angular: wp.array(dtype=wp.vec3, ndim=2), reaction: wp.array(dtype=wp.vec3, ndim=2), torque: wp.array(dtype=wp.vec3, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    reaction[world, 0] -= linear[world, 0]
+    torque[world, 0] -= angular[world, 0]
+
+@wp.kernel
+def store_residual(enabled: wp.array(dtype=int), maximum: wp.array(dtype=float, ndim=2), result: wp.array(dtype=float, ndim=2)):
+    world, _batch_tid0 = wp.tid()
+    if enabled[world] == 0:
+        return
+    result[world, result.shape[0 + 1] - 1] = maximum[world, 0]
diff --git a/blademaster_warp/batch_contact.py b/blademaster_warp/batch_contact.py
new file mode 100644
index 0000000..ca57592
--- /dev/null
+++ b/blademaster_warp/batch_contact.py
@@ -0,0 +1,483 @@
+# Generated by generate_batch_kernels.py; physics expressions retained.
+"""Tool and material contact, cutting resistance and side labels (paper Eqs. 3-6, 10-16).
+
+Symbols follow the paper:
+    sn   normal penalty factor, contact stiffness k_n = sn * me / dt^2
+    gk   tangential stiffness factor, k_t = gk * me / dt^2
+    gc   tangential damping ratio
+    mus  static friction coefficient, mud dynamic friction coefficient
+    me   reduced (effective) mass of the contact pair
+    jn   normal impulse magnitude, jt tangential impulse
+"""
+import warp as wp
+from .batch_material import compatible, insert_key
+from .friction import tangential_return
+CUT_ON = wp.constant(1)
+CUT_ADVANCE = wp.constant(2)
+CUT_HOLD = wp.constant(4)
+
+@wp.func
+def friction(n: wp.vec3, relative: wp.vec3, jn: float, history: wp.vec3, me: float, dt: float, mus: float, mud: float, gk: float, gc: float):
+    k = gk * me / (dt * dt)
+    damping = 2.0 * gc * wp.sqrt(me * k)
+    force, updated = tangential_return(n, relative, history, jn / dt, k, damping, dt, mus, mud, 1.0, -1)
+    return (dt * force, updated)
+
+@wp.func
+def blade_query(local: wp.vec3, half: wp.vec3, bevel: float):
+    closest = wp.vec3(wp.clamp(local[0], -half[0], half[0]), wp.clamp(local[1], -half[1], half[1]), wp.clamp(local[2], -half[2], half[2]))
+    delta = local - closest
+    distance = wp.length(delta)
+    normal = wp.vec3(0.0)
+    if bevel == 0.0:
+        if distance > 1e-12:
+            normal = delta / distance
+        else:
+            margin = half - wp.abs(local)
+            axis = int(0)
+            if margin[1] < margin[axis]:
+                axis = 1
+            if margin[2] < margin[axis]:
+                axis = 2
+            sign = float(1.0)
+            if local[axis] < 0.0:
+                sign = -1.0
+            if axis == 0:
+                normal = wp.vec3(sign, 0.0, 0.0)
+                closest = wp.vec3(sign * half[0], closest[1], closest[2])
+            elif axis == 1:
+                normal = wp.vec3(0.0, sign, 0.0)
+                closest = wp.vec3(closest[0], sign * half[1], closest[2])
+            else:
+                normal = wp.vec3(0.0, 0.0, sign)
+                closest = wp.vec3(closest[0], closest[1], sign * half[2])
+            distance = -margin[axis]
+    else:
+        q = wp.vec2(wp.abs(local[0]), local[2])
+        sign = float(1.0)
+        if local[0] < 0.0:
+            sign = -1.0
+        edge = wp.vec2(half[0], bevel)
+        edge_length_sq = wp.dot(edge, edge)
+        t = wp.clamp(wp.dot(q - wp.vec2(0.0, -half[2]), edge) / edge_length_sq, 0.0, 1.0)
+        near = wp.vec2(t * half[0], -half[2] + t * bevel)
+        best_sq = wp.length_sq(q - near)
+        out = wp.vec2(bevel, -half[0]) / wp.sqrt(edge_length_sq)
+        candidate = wp.vec2(half[0], wp.clamp(q[1], -half[2] + bevel, half[2]))
+        distance_sq = wp.length_sq(q - candidate)
+        if distance_sq < best_sq:
+            best_sq = distance_sq
+            near = candidate
+            out = wp.vec2(1.0, 0.0)
+        candidate = wp.vec2(wp.clamp(q[0], 0.0, half[0]), half[2])
+        distance_sq = wp.length_sq(q - candidate)
+        if distance_sq < best_sq:
+            best_sq = distance_sq
+            near = candidate
+            out = wp.vec2(0.0, 1.0)
+        inside = q[0] <= half[0] and q[1] <= half[2] and (half[0] * (q[1] + half[2]) >= bevel * q[0])
+        best = wp.sqrt(best_sq)
+        near = wp.vec2(sign * near[0], near[1])
+        out = wp.vec2(sign * out[0], out[1])
+        closest = wp.vec3(near[0], wp.clamp(local[1], -half[1], half[1]), near[1])
+        if inside and wp.abs(local[1]) <= half[1]:
+            normal = wp.vec3(out[0], 0.0, out[1])
+            distance = -best
+            if half[1] - wp.abs(local[1]) < best:
+                sign = float(1.0)
+                if local[1] < 0.0:
+                    sign = -1.0
+                closest = wp.vec3(local[0], sign * half[1], local[2])
+                normal = wp.vec3(0.0, sign, 0.0)
+                distance = -(half[1] - wp.abs(local[1]))
+        else:
+            if inside:
+                closest = wp.vec3(local[0], closest[1], local[2])
+            delta = local - closest
+            distance = wp.length(delta)
+            normal = wp.vec3(out[0], 0.0, out[1])
+            if distance > 1e-12:
+                normal = delta / distance
+    return (closest, normal, distance)
+
+@wp.func
+def penalty_impulse(gap: float, relative: wp.vec3, n: wp.vec3, me: float, history: wp.vec3, dt: float, sn: float, mus: float, mud: float, gk: float, gc: float):
+    """Predictive normal penalty plus history-based friction for one contact.
+
+    Returns (impulse, new tangential history). Both are zero when the contact
+    stays separated over the step.
+    """
+    predicted = gap + dt * wp.min(wp.dot(relative, n), 0.0)
+    if predicted >= 0.0:
+        return (wp.vec3(0.0), wp.vec3(0.0))
+    jn = sn * me / dt * -predicted
+    jt, ht = friction(n, relative, jn, history, me, dt, mus, mud, gk, gc)
+    return (jn * n + jt, ht)
+
+@wp.func
+def blade_effective_mass(world: int, mass: float, lever: wp.vec3, n: wp.vec3, q: wp.quat, blade_mass: float, inertia_inv: wp.vec3, mobility: wp.array(dtype=float, ndim=3), tool_model: int):
+    """Reduced mass of a particle against the blade along normal n.
+
+    tool_model -1: articulated tool, inverse mass u^T (J M^-1 J^T) u (paper Eq. 15).
+    tool_model  0: translating blade with mass blade_mass.
+    tool_model  1: free rigid blade, adds the rotational term.
+    """
+    inverse = 1.0 / blade_mass
+    if tool_model < 0:
+        rn = wp.cross(lever, n)
+        u = wp.spatial_vector(n[0], n[1], n[2], rn[0], rn[1], rn[2])
+        inverse = 0.0
+        for row in range(6):
+            for col in range(6):
+                inverse += u[row] * mobility[world, row, col] * u[col]
+    elif tool_model > 0:
+        rn = wp.quat_rotate_inv(q, wp.cross(lever, n))
+        inverse += wp.dot(rn, wp.cw_mul(inertia_inv, rn))
+    return 1.0 / (1.0 / mass + inverse)
+
+@wp.func
+def resist_cut(world: int, p: int, j: wp.vec3, x: wp.array(dtype=wp.vec3, ndim=2), v: wp.array(dtype=wp.vec3, ndim=2), origin: wp.vec3, tool_velocity: wp.vec3, q: wp.quat, tool_angular: wp.vec3, half: wp.vec3, radius: float, spacing: float, band: float, damage: wp.array(dtype=float, ndim=2), threshold: float, cutting: int, work: wp.array(dtype=float, ndim=2)):
+    """Cutting resistance at the blade edge.
+
+    While a particle just ahead of the edge is intact, the edge-direction
+    push does work that accumulates into its damage. Once damage reaches 1
+    that push component is removed and the edge passes through. The work rate
+    uses the edge speed relative to the particle (paper Eq. 5) or, with
+    CUT_ADVANCE, the edge's own speed along the cutting direction.
+    """
+    edge = origin + wp.quat_rotate(q, wp.vec3(0.0, 0.0, -half[2]))
+    down = wp.quat_rotate(q, wp.vec3(0.0, 0.0, -1.0))
+    edge_velocity = tool_velocity + wp.cross(tool_angular, edge - origin)
+    front = wp.dot(x[world, p] - edge, down)
+    advance = wp.dot(edge_velocity - v[world, p], down)
+    if cutting & CUT_ADVANCE != 0:
+        advance = wp.dot(edge_velocity, down)
+    local_edge = wp.quat_rotate_inv(q, x[world, p] - edge)
+    ahead_of_edge = front >= 0.0 and front <= 2.0 * radius and (wp.abs(local_edge[0]) <= band * spacing) and (wp.abs(local_edge[1]) <= half[1])
+    if not ahead_of_edge:
+        return j
+    push = wp.max(wp.dot(j, down), 0.0)
+    if damage[world, p] >= 1.0:
+        return j - push * down
+    if advance > 0.0:
+        delta = push * advance
+        wp.atomic_add(work, world, 0, delta)
+        damage[world, p] = wp.min(1.0, damage[world, p] + delta / threshold)
+    return j
+
+@wp.func
+def blade_at(world: int, p: int, x: wp.array(dtype=wp.vec3, ndim=2), v: wp.array(dtype=wp.vec3, ndim=2), tool_pos: wp.array(dtype=wp.vec3, ndim=2), tool_vel: wp.array(dtype=wp.vec3, ndim=2), tool_rot: wp.array(dtype=wp.quat, ndim=2), tool_omega: wp.array(dtype=wp.vec3, ndim=2), half: wp.vec3, bevel: float, blade_offset: float, spacing: float, band: float, mass: float, blade_mass: float, inertia_inv: wp.vec3, mobility: wp.array(dtype=float, ndim=3), tool_model: int, dt: float, sn: float, mus: float, mud: float, gk: float, gc: float, histories: wp.array(dtype=wp.vec3, ndim=3), row: int, damage: wp.array(dtype=float, ndim=2), threshold: float, cutting: int, reaction: wp.array(dtype=wp.vec3, ndim=2), torque: wp.array(dtype=wp.vec3, ndim=2), work: wp.array(dtype=float, ndim=2), parts: wp.array(dtype=wp.vec3, ndim=2)):
+    """Blade contact impulse on particle p: closest point on the (beveled) box,
+    relative velocity at that point. Friction history in histories[row, p]."""
+    xp = x[world, p]
+    q = tool_rot[world, 0]
+    origin = tool_pos[world, 0]
+    result = wp.vec3(0.0)
+    blade_radius = wp.length(half)
+    max_closing = wp.length(v[world, p]) + wp.length(tool_vel[world, 0]) + wp.length(tool_omega[world, 0]) * blade_radius
+    if wp.length(xp - origin) - blade_radius - blade_offset > dt * max_closing:
+        histories[world, row, p] = wp.vec3(0.0)
+    else:
+        local = wp.quat_rotate_inv(q, xp - origin)
+        closest_local, normal_local, distance = blade_query(local, half, bevel)
+        front = -half[2] - local[2]
+        if cutting & CUT_HOLD != 0 and damage[world, p] < 1.0 and (wp.abs(local[0]) <= half[0] + blade_offset) and (wp.abs(local[1]) <= half[1]) and (front >= 0.0):
+            closest_local = wp.vec3(local[0], local[1], -half[2])
+            normal_local = wp.vec3(0.0, 0.0, -1.0)
+            distance = front
+        lever = wp.quat_rotate(q, closest_local)
