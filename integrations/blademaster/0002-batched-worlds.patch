+@wp.kernel
+def finish_external_step(enabled: wp.array(dtype=int), reaction: wp.array(dtype=wp.vec3, ndim=2), torque: wp.array(dtype=wp.vec3, ndim=2), board: wp.array(dtype=wp.vec3, ndim=2), speed: wp.array(dtype=float, ndim=2), tool_pos: wp.array(dtype=wp.vec3, ndim=2), tool_vel: wp.array(dtype=wp.vec3, ndim=2), tool_rot: wp.array(dtype=wp.quat, ndim=2), tool_omega: wp.array(dtype=wp.vec3, ndim=2), mobility: wp.array(dtype=float, ndim=3), predict: int, dt: float, linear: wp.array(dtype=wp.vec3, ndim=2), angular: wp.array(dtype=wp.vec3, ndim=2)):
