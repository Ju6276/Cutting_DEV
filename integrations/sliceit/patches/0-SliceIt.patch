@@ -0,0 +1,315 @@
+"""Stepped consumers use authoritative snapshots without waiting for ROS topics."""
+from collections import deque
+import threading
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import rospy
+
+from ur_control.controllers import JointControllerBase
+from ur_control.fzi_cartesian_compliance_controller import CompliantController
+
+
+def stamp(seconds):
+    return rospy.Time.from_sec(seconds)
+
+
+def joint_controller(names=('angular', 'slider')):
+    controller = JointControllerBase.__new__(JointControllerBase)
+    controller.valid_joint_names = list(names)
+    controller._joint_state_lock = threading.RLock()
+    controller._joint_state_stamp = 8.
+    controller._joint_state_stamp_ns = 8_000_000_000
+    controller._current_jnt_positions = np.zeros(len(names))
+    controller._current_jnt_velocities = np.zeros(len(names))
+    controller._current_jnt_efforts = np.zeros(len(names))
+    controller._joint_names = list(names)
+    controller._jnt_positions_hist = deque(maxlen=24)
+    return controller
+
+
+def joint_message(time=10.002, names=('angular', 'slider'), position=(.2, .4),
+                  velocity=(.5, .6), effort=(.7, .8)):
+    return SimpleNamespace(
+        name=list(names), position=list(position), velocity=list(velocity),
+        effort=list(effort), header=SimpleNamespace(stamp=stamp(time)))
+
+
+def install(controller, message=None, angular=(True, False), start=10., end=10.002):
+    return controller.install_step_joint_state(
+        joint_message() if message is None else message,
+        list(angular), stamp(start), stamp(end))
+
+
+def test_snapshot_install_needs_no_topic_and_returns_copied_state():
+    joints = joint_controller()
+    result = install(joints)
+    np.testing.assert_allclose(result['q'], [.2, .4])
+    np.testing.assert_allclose(result['qd'], [.5, .6])
+    assert result['stamp'] == 10.002
+    result['q'][:] = 99.
+    np.testing.assert_allclose(joints.get_joint_state()['q'], [.2, .4])
+
+
+def test_snapshot_joint_order_and_angular_flags_follow_names():
+    joints = joint_controller()
+    joints._current_jnt_positions[:] = [3.1, 0.]
+    result = install(joints, joint_message(
+        names=('slider', 'angular'), position=(7., -3.1),
+        velocity=(.6, .5), effort=(.8, .7)), angular=(False, True))
+    np.testing.assert_allclose(result['q'], [2. * np.pi - 3.1, 7.])
+    np.testing.assert_allclose(result['qd'], [.5, .6])
+    np.testing.assert_allclose(joints._current_jnt_efforts, [.7, .8])
+
+
+@pytest.mark.parametrize('initial, raw, expected', [
+    (3.1, -3.1, 2. * np.pi - 3.1),
+    (-3.1, 3.1, 3.1 - 2. * np.pi),
+    (4. * np.pi + .1, .2, 4. * np.pi + .2),
+])
+def test_angular_snapshot_preserves_unwrapped_branch(initial, raw, expected):
+    joints = joint_controller()
+    joints._current_jnt_positions[:] = [initial, initial]
+    state = install(joints, joint_message(position=(raw, raw)))
+    np.testing.assert_allclose(state['q'], [expected, raw])
+
+
+@pytest.mark.parametrize('message_time', [8., 10., 10.001, 10.002])
+def test_late_or_equal_topic_sample_cannot_overwrite_completed_snapshot(message_time):
+    joints = joint_controller()
+    install(joints)
+    history_length = len(joints._jnt_positions_hist)
+    joints.joint_states_cb(joint_message(
+        time=message_time, position=(90., 91.), velocity=(92., 93.), effort=(94., 95.)))
+    state = joints.get_joint_state()
+    assert state['stamp'] == 10.002
+    np.testing.assert_allclose(state['q'], [.2, .4])
+    np.testing.assert_allclose(state['qd'], [.5, .6])
+    np.testing.assert_allclose(joints._current_jnt_efforts, [.7, .8])
+    assert len(joints._jnt_positions_hist) == history_length
+
+
+def test_newer_topic_sample_remains_usable_after_stepping():
+    joints = joint_controller()
+    install(joints)
+    joints.joint_states_cb(joint_message(time=10.003, position=(.3, .5)))
+    assert joints.get_joint_state()['stamp'] == 10.003
+    np.testing.assert_allclose(joints.get_joint_state()['q'], [.3, .5])
+
+
+@pytest.mark.parametrize('field, value', [
+    ('name', ['angular']),
+    ('name', ['angular', 'angular']),
+    ('name', ['angular', 'unknown']),
+    ('name', ['angular', 'slider', 'extra']),
+    ('position', [.2]),
+    ('velocity', []),
+    ('effort', [.7, .8, .9]),
+    ('position', [np.nan, .4]),
+    ('position', [.2, np.inf]),
+    ('velocity', [np.inf, .6]),
+    ('effort', [.7, -np.inf]),
+])
+def test_malformed_snapshot_rejected_without_partial_state_update(field, value):
+    joints = joint_controller()
+    message = joint_message()
+    setattr(message, field, value)
+    with pytest.raises(rospy.ROSException):
+        install(joints, message)
+    assert joints.get_joint_state()['stamp'] == 8.
+    np.testing.assert_array_equal(joints.get_joint_state()['q'], [0., 0.])
+    assert not joints._jnt_positions_hist
+
+
+@pytest.mark.parametrize('angular', [(), (True,), (True, False, True)])
+def test_angular_flags_must_cover_every_joint(angular):
+    with pytest.raises(rospy.ROSException):
+        install(joint_controller(), angular=angular)
+
+
+@pytest.mark.parametrize('start, end, message_time', [
+    (10., 10., 10.),
+    (10.002, 10., 10.),
+    (10., 10.002, 10.),
+    (10., 10.002, 10.001),
+    (10., 10.002, 10.003),
+])
+def test_snapshot_requires_positive_interval_and_exact_end_stamp(start, end, message_time):
+    joints = joint_controller()
+    with pytest.raises(rospy.ROSException):
+        install(joints, joint_message(time=message_time), start=start, end=end)
+    assert joints.get_joint_state()['stamp'] == 8.
+
+
+def test_step_consumer_installs_response_without_waiting_or_extra_ticks():
+    joints = joint_controller()
+    calls = []
+    response = SimpleNamespace(
+        success=True, start_time=stamp(10.), end_time=stamp(10.002),
+        joint_state=joint_message(), joint_is_angular=[True, False])
+    def step(request):
+        calls.append((request.steps, list(request.joint_names)))
+        return response
+    arm = SimpleNamespace(step_simulation_serv=step, joint_traj_controller=joints)
+    actual = CompliantController.advance_gazebo(arm, steps=2)
+    assert actual is response
+    assert calls == [(2, ['angular', 'slider'])]
+    assert (actual.end_time - actual.start_time).to_nsec() == 2_000_000
+    np.testing.assert_allclose(joints.get_joint_state()['q'], [.2, .4])
+
+
+def test_failed_step_does_not_consume_joint_or_publish_stale_knife_pose():
+    joints = joint_controller()
+    events = []
+    arm = SimpleNamespace(
+        step_simulation_serv=lambda request: SimpleNamespace(
+            success=False, status_message='step failed'),
+        joint_traj_controller=joints)
+    with pytest.raises(rospy.ROSException, match='step failed'):
+        CompliantController.advance_gazebo(arm, steps=2)
+        events.append('knife')
+    assert events == []
+    assert joints.get_joint_state()['stamp'] == 8.
+
+
+def test_invalid_step_snapshot_prevents_downstream_knife_publish():
+    joints = joint_controller()
+    events = []
+    arm = SimpleNamespace(
+        step_simulation_serv=lambda request: SimpleNamespace(
+            success=True, start_time=stamp(10.), end_time=stamp(10.002),
+            joint_state=joint_message(time=10.), joint_is_angular=[True, False]),
+        joint_traj_controller=joints)
+    with pytest.raises(rospy.ROSException):
+        CompliantController.advance_gazebo(arm, steps=2)
+        events.append('knife')
+    assert events == []
+
+
+def test_older_topic_cannot_rollback_a_newer_topic_after_snapshot():
+    joints = joint_controller()
+    install(joints)
+    joints.joint_states_cb(joint_message(time=10.005, position=(.5, .7)))
+    joints.joint_states_cb(joint_message(time=10.003, position=(.3, .5)))
+    assert joints.get_joint_state()['stamp'] == 10.005
+    np.testing.assert_allclose(joints.get_joint_state()['q'], [.5, .7])
+
+
+def test_simulation_clock_rewind_requires_new_consumer_without_mutating_state():
+    joints = joint_controller()
+    install(joints)
+    with pytest.raises(rospy.ROSException, match='clock reversed'):
+        install(joints, joint_message(time=.002), start=0., end=.002)
+    assert joints.get_joint_state()['stamp'] == 10.002
+    np.testing.assert_allclose(joints.get_joint_state()['q'], [.2, .4])
+
+
+def test_explicit_snapshot_accepts_zero_interval_and_rejects_queued_topics():
+    joints = joint_controller()
+    result = joints.install_step_joint_state(
+        joint_message(time=10.), [True, False], stamp(10.), stamp(10.),
+        snapshot_only=True)
+    assert result['stamp'] == 10.
+    for time in (9.999, 10.):
+        joints.joint_states_cb(joint_message(time=time, position=(80., 90.)))
+    np.testing.assert_allclose(joints.get_joint_state()['q'], [.2, .4])
+    assert joints.get_joint_state()['stamp'] == 10.
+    assert joints._joint_state_stamp_ns == 10_000_000_000
+
+
+@pytest.mark.parametrize('start, end', [(10., 10.002), (10.002, 10.)])
+def test_snapshot_only_rejects_nonzero_intervals(start, end):
+    joints = joint_controller()
+    with pytest.raises(rospy.ROSException):
+        joints.install_step_joint_state(
+            joint_message(time=end), [True, False], stamp(start), stamp(end),
+            snapshot_only=True)
+    assert joints.get_joint_state()['stamp'] == 8.
+
+
+def test_positive_step_continues_from_zero_tick_snapshot():
+    joints = joint_controller()
+    joints.install_step_joint_state(
+        joint_message(time=10.), [True, False], stamp(10.), stamp(10.),
+        snapshot_only=True)
+    result = install(joints)
+    assert result['stamp'] == 10.002
+
+
+def test_snapshot_client_requests_zero_ticks_and_explicit_mode():
+    joints = joint_controller()
+    calls = []
+    response = SimpleNamespace(
+        success=True, start_time=stamp(10.), end_time=stamp(10.),
+        joint_state=joint_message(time=10.), joint_is_angular=[True, False])
+    def snapshot(request):
+        calls.append((request.steps, request.snapshot_only, list(request.joint_names)))
+        return response
+    arm = SimpleNamespace(step_simulation_serv=snapshot, joint_traj_controller=joints)
+    actual = CompliantController.snapshot_gazebo(arm)
+    assert actual is response
+    assert calls == [(0, True, ['angular', 'slider'])]
+    assert actual.end_time.to_nsec() == actual.start_time.to_nsec()
+    assert joints.get_joint_state()['stamp'] == 10.
+
+
+def test_failed_zero_tick_snapshot_keeps_existing_state():
+    joints = joint_controller()
+    arm = SimpleNamespace(
+        step_simulation_serv=lambda request: SimpleNamespace(
+            success=False, status_message='snapshot failed'),
+        joint_traj_controller=joints)
+    with pytest.raises(rospy.ROSException, match='snapshot failed'):
+        CompliantController.snapshot_gazebo(arm)
+    assert joints.get_joint_state()['stamp'] == 8.
+
+
+def test_first_and_later_resets_snapshot_before_observation_despite_queued_topics(monkeypatch):
+    from ur3e_openai.robot_env import RobotGazeboEnv
+    from ur3e_openai.robot_envs.ur3e_env import UR3eEnv
+
+    events = []
+    joints = joint_controller()
+    env = UR3eEnv.__new__(UR3eEnv)
+    env.use_step_control = True
+    env._update_episode = lambda: events.append('episode')
+    env._init_env_variables = lambda: events.append('init')
+    env.robot_connection = SimpleNamespace(pause=lambda: events.append('pause'))
+    monkeypatch.setattr(RobotGazeboEnv, '_reset_sim', lambda self: events.append('motion'))
+    reset_times = iter((10., 20.))
+    observed = []
+    def snapshot():
+        events.append('snapshot')
+        time = next(reset_times)
+        joints.install_step_joint_state(
+            joint_message(time=time, position=(time / 100., time / 10.)),
+            [False, False], stamp(time), stamp(time), snapshot_only=True)
+        # A final pre-integration message can arrive after the pause response.
+        joints.joint_states_cb(joint_message(time=time, position=(80., 90.)))
+    env.ur3e_arm = SimpleNamespace(snapshot_gazebo=snapshot)
+    def observation():
+        events.append('observation')
+        state = joints.get_joint_state()
+        observed.append(state)
+        return state['q']
+    env._get_obs = observation
+    for time in (10., 20.):
+        result = RobotGazeboEnv.reset(env)
+        np.testing.assert_allclose(result, [time / 100., time / 10.])
+        assert observed[-1]['stamp'] == time
+        np.testing.assert_array_equal(result, joints.get_joint_state()['q'])
+    assert events == ['episode', 'init', 'motion', 'snapshot', 'pause', 'observation'] * 2
+
+
+def test_continuous_reset_retains_original_motion_without_snapshot(monkeypatch):
+    from ur3e_openai.robot_env import RobotGazeboEnv
+    from ur3e_openai.robot_envs.ur3e_env import UR3eEnv
+
+    events = []
+    env = UR3eEnv.__new__(UR3eEnv)
+    env.use_step_control = False
+    env.ur3e_arm = SimpleNamespace(snapshot_gazebo=lambda: events.append('snapshot'))
+    monkeypatch.setattr(RobotGazeboEnv, '_reset_sim', lambda self: events.append('motion'))
+    env._reset_sim()
+    assert events == ['motion']
