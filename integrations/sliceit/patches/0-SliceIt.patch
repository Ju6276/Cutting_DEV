@@ -0,0 +1,72 @@
+"""Run with the SliceIt ROS Python environment; no master is started."""
+import importlib.util
+from pathlib import Path
+import unittest
+from unittest.mock import Mock
+
+import numpy as np
+import rospy
+from geometry_msgs.msg import WrenchStamped
+from ur_control import conversions
+
+
+path = Path(__file__).resolve().parents[1] / 'scripts/disect_wrench_relay.py'
+spec = importlib.util.spec_from_file_location('disect_wrench_relay', path)
+relay = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(relay)
+
+
+class RelayTests(unittest.TestCase):
+    def message(self, wrench):
+        message = WrenchStamped()
+        message.header.stamp = rospy.Time(12, 345)
+        message.wrench = conversions.to_wrench(np.asarray(wrench, dtype=float))
+        return message
+
+    def test_identity_preserves_wrench_and_stamp(self):
+        message = self.message([1, 2, 3, 4, 5, 6])
+        result = relay.sensor_message(message, [0, 0, 0], [0, 0, 0, 1])
+        np.testing.assert_allclose(conversions.from_wrench(result.wrench), [1, 2, 3, 4, 5, 6])
+        self.assertEqual(result.header.stamp, message.header.stamp)
+        self.assertEqual(result.header.frame_id, relay.SENSOR_FRAME)
+
+    def test_source_rotation_translation_convention(self):
+        quaternion = [0, 0, np.sqrt(.5), np.sqrt(.5)]
+        result = relay.sensor_message(self.message([1, 0, 0, 0, 0, 2]),
+                                      [1, 2, 3], quaternion)
+        # Source spalg uses F' = R F + p x (R torque), torque' = R torque.
+        np.testing.assert_allclose(conversions.from_wrench(result.wrench),
+                                   [4, -1, 0, 0, 0, 2], atol=1e-14)
+
+    def test_disect_zero_torque_only_rotates_force(self):
+        result = relay.sensor_message(self.message([0, 10, 0, 0, 0, 0]),
+                                      [1, 2, 3], [0, 0, np.sqrt(.5), np.sqrt(.5)])
+        np.testing.assert_allclose(conversions.from_wrench(result.wrench),
+                                   [-10, 0, 0, 0, 0, 0], atol=1e-14)
+
+    def test_callback_looks_up_sensor_from_base(self):
+        node = relay.WrenchRelay.__new__(relay.WrenchRelay)
+        node.listener = Mock()
+        node.listener.lookupTransform.return_value = ([0, 0, 0], [0, 0, 0, 1])
+        node.publisher = Mock()
+        node.callback(self.message([0, 10, 0, 0, 0, 0]))
+        node.listener.lookupTransform.assert_called_once_with(
+            relay.SENSOR_FRAME, relay.BASE_FRAME, rospy.Time(0))
+        self.assertEqual(node.publisher.publish.call_count, 1)
+
+    def test_launch_connects_filter_to_gazebo_controller(self):
+        import roslaunch
+        import roslib.packages
+        launch = path.parents[1] / 'launch/b_bot_gazebo.launch'
+        config = roslaunch.config.load_config_default([str(launch)], None, verbose=False)
+        nodes = {node.name: node for node in config.nodes}
+        expected = ['/b_bot/cartesian_compliance_controller/ft_sensor_wrench',
+                    '/b_bot/wrench/filtered']
+        self.assertIn(expected, nodes['gazebo'].remap_args)
+        self.assertIn('-t2 /disect/wrench_sensor', nodes['b_bot_ft_filter'].args)
+        self.assertEqual(nodes['disect_wrench_relay'].package, 'o2ac_gazebo')
+        self.assertTrue(roslib.packages.find_node('o2ac_gazebo', 'disect_wrench_relay.py'))
+
+
+if __name__ == '__main__':
+    unittest.main()
