index 0000000..10f86fb
--- /dev/null
+++ b/tests/test_controller_configuration.py
@@ -0,0 +1,82 @@
+"""Source controller parameter ordering before stepped physics advances."""
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from ur_control.fzi_cartesian_compliance_controller import CompliantController
+
+
+def test_stepped_action_waits_for_every_parameter_rpc_before_physics():
+    entered = threading.Event()
+    release = threading.Event()
+    completed = threading.Event()
+    events = []
+    def first(parameters):
+        events.append('first_begin')
+        entered.set()
+        assert release.wait(5)
+        events.append('first_end')
+    def second(parameters):
+        events.append('second_end')
+    controller = SimpleNamespace(async_mode=True, use_step_control=True, update_thread=None,
+        dyn_config_clients={'first': SimpleNamespace(update_configuration=first),
+                            'second': SimpleNamespace(update_configuration=second)})
+    def action():
+        try:
+            CompliantController.update_controller_parameters(controller, {'first': {'p': 1}, 'second': {'p': 2}})
+            events.append('physics')
+        finally:
+            completed.set()
+    worker = threading.Thread(target=action)
+    worker.start()
+    try:
+        assert entered.wait(5)
+        assert events == ['first_begin']
+        assert not completed.is_set()
+    finally:
+        release.set()
+        worker.join(5)
+    assert not worker.is_alive()
+    assert events == ['first_begin', 'first_end', 'second_end', 'physics']
+
+
+def test_continuous_async_updates_still_return_before_rpc_finishes():
+    entered = threading.Event()
+    release = threading.Event()
+    finished = threading.Event()
+    def update(parameters):
+        entered.set()
+        assert release.wait(5)
+        finished.set()
+    controller = SimpleNamespace(async_mode=True, use_step_control=False, update_thread=None,
+        dyn_config_clients={'gains': SimpleNamespace(update_configuration=update)})
+    try:
+        CompliantController.update_controller_parameters(controller, {'gains': {'p': 1}})
+        assert entered.wait(5)
+        assert not finished.is_set()
+    finally:
+        release.set()
+        controller.update_thread.join(5)
+    assert finished.is_set()
+
+
+def test_stepped_parameter_failure_prevents_physics_and_reaches_caller():
+    events = []
+    def fail(parameters):
+        raise RuntimeError('configuration service failed')
+    controller = SimpleNamespace(async_mode=True, use_step_control=True, update_thread=None,
+        dyn_config_clients={'gains': SimpleNamespace(update_configuration=fail)})
+    with pytest.raises(RuntimeError, match='configuration service failed'):
+        CompliantController.update_controller_parameters(controller, {'gains': {'p': 1}})
+        events.append('physics')
+    assert events == []
+
+
+def test_stepped_update_joins_existing_worker_before_new_rpc():
+    events = []
+    worker = SimpleNamespace(is_alive=lambda: True, join=lambda: events.append('join'))
+    controller = SimpleNamespace(async_mode=True, use_step_control=True, update_thread=worker,
+        dyn_config_clients={'gains': SimpleNamespace(update_configuration=lambda p: events.append('rpc'))})
+    CompliantController.update_controller_parameters(controller, {'gains': {'p': 1}})
+    assert events == ['join', 'rpc']
