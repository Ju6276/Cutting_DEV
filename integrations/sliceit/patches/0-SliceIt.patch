--- /dev/null
+++ b/catkin_ws/src/o2ac_gazebo/scripts/disect_wrench_relay.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Convert DiSECt's robot-base wrench to the Gazebo wrist sensor frame."""
+import rospy
+import tf
+from geometry_msgs.msg import WrenchStamped
+from ur_control import conversions, spalg
+
+
+BASE_FRAME = 'b_bot_base_link'
+SENSOR_FRAME = 'b_bot_wrist_3_link'
+
+
+def sensor_message(message, translation, quaternion):
+    """Use SliceIt's [force, torque] transform and retain its simulation stamp."""
+    sensor_from_base = list(translation) + list(quaternion)
+    wrench = spalg.convert_wrench(conversions.from_wrench(message.wrench),
+                                 sensor_from_base)
+    result = WrenchStamped()
+    result.header.stamp = message.header.stamp
+    result.header.frame_id = SENSOR_FRAME
+    result.wrench = conversions.to_wrench(wrench)
+    return result
+
+
+class WrenchRelay:
+    def __init__(self):
+        self.listener = tf.TransformListener()
+        self.publisher = rospy.Publisher('/disect/wrench_sensor', WrenchStamped,
+                                         queue_size=10)
+        self.subscriber = rospy.Subscriber('/disect/wrench', WrenchStamped,
+                                          self.callback, queue_size=10)
+
+    def callback(self, message):
+        # ROSVisualizer leaves frame_id empty; its wrench is in robot base.
+        if message.header.frame_id not in ('', BASE_FRAME, '/' + BASE_FRAME):
+            rospy.logerr_throttle(1., 'DiSECt wrench must be in ' + BASE_FRAME)
+            return
+        try:
+            # TF arrives at the joint-state publication rate. Use its latest
+            # pose while keeping the source stamp for the FT filter's 10 ms gate.
+            translation, quaternion = self.listener.lookupTransform(
+                SENSOR_FRAME, BASE_FRAME, rospy.Time(0))
+        except (tf.LookupException, tf.ConnectivityException, tf.ExtrapolationException) as error:
+            rospy.logwarn_throttle(1., 'Waiting for DiSECt wrench sensor TF: %s', error)
+            return
+        self.publisher.publish(sensor_message(message, translation, quaternion))
+
+
+if __name__ == '__main__':
+    rospy.init_node('disect_wrench_relay')
+    relay = WrenchRelay()
+    rospy.spin()
