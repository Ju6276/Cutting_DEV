index 0000000..ee7705b
--- /dev/null
+++ b/scripts/check_step_snapshot.py
@@ -0,0 +1,209 @@
+#!/usr/bin/env python3
+"""Stress completed Gazebo joint snapshots against an already running ROS master."""
+import argparse
+from collections import deque
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import threading
+import time
+from types import SimpleNamespace
+
+import numpy as np
+import rospy
+from gazebo_msgs.srv import GetJointProperties, GetPhysicsProperties, GetWorldProperties
+from gazebo_msgs.srv import StepControl, StepControlRequest
+from sensor_msgs.msg import JointState
+from std_srvs.srv import Empty
+from ur_control.controllers import JointControllerBase
+from ur_control.fzi_cartesian_compliance_controller import CompliantController
+
+
+def revision(directory):
+    return {
+        'commit': subprocess.check_output(
+            ['git', '-C', str(directory), 'rev-parse', 'HEAD'], text=True).strip(),
+        'dirty': bool(subprocess.check_output(
+            ['git', '-C', str(directory), 'status', '--porcelain'], text=True)),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--calls', type=int, default=20000)
+    parser.add_argument('--timeout', type=float, default=600.)
+    parser.add_argument('--namespace', default='/b_bot')
+    parser.add_argument('--topic', default='/joint_states')
+    parser.add_argument('--output', required=True)
+    parser.add_argument('--unpause-boundary', action='store_true')
+    parser.add_argument('--compare-every', type=int, default=1000)
+    args = parser.parse_args()
+    if args.calls < 1 or args.timeout <= 0 or args.compare_every < 1:
+        parser.error('calls, timeout and compare-every must be positive')
+    root = Path(__file__).resolve().parents[1]
+    output = Path(args.output).resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    report = {
+        'config': vars(args), 'ros_master_uri': os.environ.get('ROS_MASTER_URI'),
+        'git': revision(root),
+        'utilities_git': revision(root / 'underlay_ws/src/ur_python_utilities'),
+        'gazebo_git': revision(root / 'underlay_ws/src/third_party/gazebo_ros_pkgs'),
+        'status': 'running', 'calls_completed': 0, 'property_comparisons': 0,
+        'max_position_error': 0., 'max_velocity_error': 0.,
+        'topic_not_newer_at_response': 0, 'max_call_wall_seconds': 0.,
+    }
+    started = time.monotonic()
+    initial_sub = observer_sub = None
+    def timeout_handler(signum, frame):
+        raise TimeoutError('Snapshot stress exceeded wall-time budget')
+    signal.signal(signal.SIGALRM, timeout_handler)
+    signal.setitimer(signal.ITIMER_REAL, args.timeout)
+    try:
+        rospy.init_node('check_step_snapshot', anonymous=True, disable_signals=True)
+        for name in ('step_control', 'get_physics_properties', 'get_joint_properties',
+                     'get_world_properties', 'pause_physics', 'unpause_physics'):
+            rospy.wait_for_service('/gazebo/' + name, timeout=20.)
+        step = rospy.ServiceProxy('/gazebo/step_control', StepControl, persistent=True)
+        physics = rospy.ServiceProxy('/gazebo/get_physics_properties', GetPhysicsProperties)
+        properties = rospy.ServiceProxy('/gazebo/get_joint_properties', GetJointProperties)
+        world = rospy.ServiceProxy('/gazebo/get_world_properties', GetWorldProperties)
+        pause = rospy.ServiceProxy('/gazebo/pause_physics', Empty)
+        unpause = rospy.ServiceProxy('/gazebo/unpause_physics', Empty)
+        names = None
+        namespace = args.namespace.rstrip('/')
+        for suffix in ('joint_state_controller/joints', 'ur_hardware_interface/joints',
+                       'scaled_pos_joint_traj_controller/joints'):
+            candidate = rospy.get_param(namespace + '/' + suffix, None)
+            if candidate:
+                names = list(candidate)
+                break
+        initial = []
+        ready = threading.Event()
+        def initial_callback(message):
+            if names is None or set(names).issubset(message.name):
+                initial[:] = [message]
+                ready.set()
+        initial_sub = rospy.Subscriber(args.topic, JointState, initial_callback, queue_size=1)
+        if not ready.wait(20.):
+            raise TimeoutError('No initial joint state; start this check with the world running')
+        initial_sub.unregister()
+        initial_sub = None
+        message = initial[0]
+        if names is None:
+            prefix = namespace.strip('/') + '_'
+            names = [name for name in message.name if name.startswith(prefix)]
+        if not names or len(names) != len(set(names)):
+            raise RuntimeError('No unique requested joints available')
+        order = [message.name.index(name) for name in names]
+        joints = JointControllerBase.__new__(JointControllerBase)
+        joints.valid_joint_names = names
+        joints._joint_names = names.copy()
+        joints._joint_state_lock = threading.RLock()
+        joints._joint_state_stamp = message.header.stamp.to_sec()
+        joints._joint_state_stamp_ns = message.header.stamp.to_nsec()
+        joints._current_jnt_positions = np.asarray(message.position)[order]
+        joints._current_jnt_velocities = np.asarray(message.velocity)[order]
+        joints._current_jnt_efforts = np.asarray(message.effort)[order]
+        joints._jnt_positions_hist = deque(maxlen=24)
+        observed = {'stamp_ns': 0, 'messages': 0}
+        observer_lock = threading.Lock()
+        def observe(message):
+            if set(names).issubset(message.name):
+                with observer_lock:
+                    observed['stamp_ns'] = message.header.stamp.to_nsec()
+                    observed['messages'] += 1
+        observer_sub = rospy.Subscriber(args.topic, JointState, observe, queue_size=1)
+        arm = SimpleNamespace(step_simulation_serv=step, joint_traj_controller=joints)
+        pause()
+        settings = physics()
+        assert settings.success and settings.pause
+        tick_ns = rospy.Duration.from_sec(settings.time_step).to_nsec()
+        assert tick_ns > 0
+        report.update(joint_names=names, tick_ns=tick_ns, consumer_topic_subscribed=False)
+
+        def validate(response, steps):
+            assert response.success, response.status_message
+            assert response.end_time.to_nsec() - response.start_time.to_nsec() == steps * tick_ns
+            assert response.joint_state.header.stamp == response.end_time
+            assert list(response.joint_state.name) == names
+            state = joints.get_joint_state()
+            assert state['stamp'] == response.end_time.to_sec()
+            assert np.isfinite(state['q']).all() and np.isfinite(state['qd']).all()
+            assert np.isfinite(response.joint_state.effort).all()
+
+        def compare(response):
+            for index, name in enumerate(names):
+                reference = properties(name)
+                assert reference.success, reference.status_message
+                q_error = response.joint_state.position[index] - reference.position[0]
+                if response.joint_is_angular[index]:
+                    q_error = np.arctan2(np.sin(q_error), np.cos(q_error))
+                qd_error = response.joint_state.velocity[index] - reference.rate[0]
+                report['max_position_error'] = max(report['max_position_error'], abs(float(q_error)))
+                report['max_velocity_error'] = max(report['max_velocity_error'], abs(float(qd_error)))
+                assert abs(q_error) <= 1e-10 and abs(qd_error) <= 1e-10
+                report['property_comparisons'] += 1
+
+        invalid = [(2, ['__step_snapshot_missing_joint__']), (2, [names[0], names[0]]),
+                   (0, names), (2, [''])]
+        for steps, invalid_names in invalid:
+            before = world()
+            response = step(StepControlRequest(steps=steps, joint_names=invalid_names))
+            after = world()
+            assert not response.success
+            assert before.sim_time == after.sim_time
+            assert physics().pause
+        report['invalid_requests_rejected_without_advancing'] = len(invalid)
+        for ticks in (1, 5):
+            response = step(StepControlRequest(steps=ticks, joint_names=names))
+            joints.install_step_joint_state(response.joint_state, response.joint_is_angular,
+                                            response.start_time, response.end_time)
+            validate(response, ticks)
+            compare(response)
+        report['other_step_counts'] = [1, 5]
+        if args.unpause_boundary:
+            unpause()
+            response = CompliantController.advance_gazebo(arm, steps=2)
+            validate(response, 2)
+            assert physics().pause
+            report['unpause_boundary_passed'] = True
+        next_progress = time.monotonic()
+        for index in range(args.calls):
+            call_start = time.monotonic()
+            response = CompliantController.advance_gazebo(arm, steps=2)
+            report['max_call_wall_seconds'] = max(
+                report['max_call_wall_seconds'], time.monotonic() - call_start)
+            validate(response, 2)
+            with observer_lock:
+                if observed['stamp_ns'] <= response.start_time.to_nsec():
+                    report['topic_not_newer_at_response'] += 1
+            if index % args.compare_every == 0 or index + 1 == args.calls:
+                compare(response)
+            report['calls_completed'] = index + 1
+            if time.monotonic() >= next_progress:
+                report['wall_seconds'] = time.monotonic() - started
+                print(json.dumps({'calls': index + 1, 'wall_seconds': report['wall_seconds'],
+                                  'topic_not_newer_at_response': report['topic_not_newer_at_response']}), flush=True)
+                (output / 'progress.json').write_text(json.dumps(report, indent=2) + '\n')
+                next_progress = time.monotonic() + 5.
+        report['observer_messages'] = observed['messages']
+        report['status'] = 'passed'
+    except BaseException as error:
+        report['status'] = 'failed'
+        report['error'] = '{}: {}'.format(type(error).__name__, error)
+        raise
+    finally:
+        signal.setitimer(signal.ITIMER_REAL, 0)
+        if initial_sub is not None:
+            initial_sub.unregister()
+        if observer_sub is not None:
+            observer_sub.unregister()
+        report['wall_seconds'] = time.monotonic() - started
+        (output / 'report.json').write_text(json.dumps(report, indent=2) + '\n')
+        print(json.dumps(report), flush=True)
+
+
+if __name__ == '__main__':
+    main()
