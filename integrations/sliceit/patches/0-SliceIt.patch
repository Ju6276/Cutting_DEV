+++ b/scripts/public_ros_bridge.py
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""Run SliceIt's ROS cutting bridge with an explicit scene and optional fitted parameters."""
+import argparse
+import copy
+import json
+import threading
+import time
+from pathlib import Path
+
+import numpy as np
+import rospy
+import tf
+import torch
+from geometry_msgs.msg import WrenchStamped
+from nav_msgs.msg import Odometry
+from std_srvs.srv import Empty, EmptyResponse
+from ur_control import conversions
+from disect.cutting import CuttingSim, load_settings
+from disect.cutting.ros_visualizer import ROSVisualizer
+
+
+class PublicBridge(ROSVisualizer):
+    def __init__(self, config, output, parameters=None):
+        self.config = Path(config).resolve()
+        self.output = Path(output).resolve()
+        self.output.mkdir(parents=True, exist_ok=True)
+        self.parameter_file = parameters
+        self.ros_frequency = 500
+        self.sim = None
+        self.episode = -1
+        self.lock = threading.RLock()
+        self.tf_listener = tf.TransformListener()
+        self.tf_listener.waitForTransform(
+            "b_bot_base_link", "cutting_board_disect", rospy.Time(0), rospy.Duration(20)
+        )
+        msg = conversions.to_pose_stamped("cutting_board_disect", [0, 0, 0, 0, 0, 0, 1])
+        transformed = self.tf_listener.transformPose("b_bot_base_link", msg)
+        self.transform_to_robot_base = conversions.from_pose_to_list(transformed.pose)
+        self.wrench_pub = rospy.Publisher("/disect/wrench", WrenchStamped, queue_size=10)
+        self.services = [
+            rospy.Service("/disect/load", Empty, self.load),
+            rospy.Service("/disect/reset", Empty, self.reset),
+            rospy.Service("/disect/step_simulation", Empty, self.step_simulation),
+        ]
+        self.subscriber = rospy.Subscriber(
+            "/disect/knife/odom", Odometry, self.update_knife_pose, queue_size=10
+        )
+        rospy.on_shutdown(self.save)
+        rospy.loginfo("Public-data DiSECt bridge ready: %s", self.config)
+
+    @torch.no_grad()
+    def load(self, req=None):
+        with self.lock:
+            self.save()
+            settings = load_settings(str(self.config))
+            settings.sim_dt = 1e-5
+            settings.sim_substeps = 500
+            self.sim = CuttingSim(
+                settings, experiment_name="public_ros", adapter="cuda",
+                requires_grad=False, allow_nans=False,
+            )
+            self.sim.cut()
+            if self.parameter_file:
+                self.sim.load_optimized_parameters(self.parameter_file, verbose=True)
+                self.sim.init_parameters()
+                self.sim.state = self.sim.model.state()
+                self.sim.assign_parameters()
+            else:
+                self.sim.state = self.sim.model.state()
+            self.sim.disable_gradients()
+            self.start_model = copy.copy(self.sim.model)
+            self.initial_q = self.sim.state.particle_q.detach().cpu().numpy().copy()
+            self.episode += 1
+            self.begin_recording()
+            return EmptyResponse()
+
+    def begin_recording(self):
+        self.recording = True
+        self.rows = []
+        self.frames = []
+        self.hist_knife_force = []
+        self.hist_time = []
+        self.calls = 0
+        self.sim_step = 0
+        self.started = time.monotonic()
+        self.initial_ke = self.sim.state.cut_spring_ke.detach().cpu().numpy().copy()
+
+    @torch.no_grad()
+    def reset(self, req=None):
+        with self.lock:
+            self.save()
+            self.recording = False
+            result = super().reset(req)
+            self.episode += 1
+            self.begin_recording()
+            self.update_view()
+            return result
+
+    @torch.no_grad()
+    def update_knife_pose(self, msg):
+        with self.lock:
+            if self.sim is None:
+                return
+            super().update_knife_pose(msg)
+
+    @torch.no_grad()
+    def step_simulation(self, req=None):
+        with self.lock:
+            if self.sim is None:
+                raise rospy.ServiceException("Load a scene before stepping.")
+            result = super().step_simulation(req)
+            self.calls += 1
+            if self.calls % 500 == 0:
+                self.save()
+                rospy.loginfo("Cutting time %.3f s, force %.3f N, released %d/%d",
+                              self.sim.sim_time, self.rows[-1]["force"],
+                              self.rows[-1]["zero_springs"], len(self.initial_ke))
+            return result
+
+    def update_view(self):
+        if not getattr(self, 'recording', False):
+            return
+        if self.calls % 25:
+            return
+        q = self.sim.state.particle_q.detach().cpu().numpy()
+        ke = self.sim.state.cut_spring_ke.detach().cpu().numpy()
+        if not np.isfinite(q).all() or not np.isfinite(ke).all():
+            raise rospy.ServiceException("Non-finite cutting state.")
+        force = self.hist_knife_force[-1] if self.hist_knife_force else 0.0
+        self.rows.append({
+            "time": self.sim.sim_time, "force": force,
+            "knife_position": self.sim.motion.current_pos.detach().cpu().tolist(),
+            "zero_springs": int(np.count_nonzero(ke == 0)),
+            "mean_stiffness": float(ke.mean()),
+            "min_particle_y": float(q[:, 1].min()),
+            "max_particle_y": float(q[:, 1].max()),
+        })
+        self.frames.append(q.copy())
+
+    def save(self):
+        if self.sim is None or not hasattr(self, "rows"):
+            return
+        with self.lock:
+            report = {
+                "config": str(self.config), "fitted_parameters": self.parameter_file,
+                "episode": self.episode, "simulation_seconds": self.sim.sim_time,
+                "wall_seconds": time.monotonic() - self.started,
+                "vertices": len(self.initial_q), "springs": len(self.initial_ke),
+                "calls": self.calls, "rows": self.rows,
+                "final_zero_springs": int((self.sim.state.cut_spring_ke == 0).sum().item()),
+                "final_knife_position": self.sim.motion.current_pos.detach().cpu().tolist(),
+            }
+            path = self.output / ("episode_%03d.json" % self.episode)
+            path.write_text(json.dumps(report, indent=2) + "\n")
+            if self.frames:
+                np.savez_compressed(
+                    self.output / ("episode_%03d.npz" % self.episode),
+                    positions=np.asarray(self.frames), initial=self.initial_q,
+                    spring_initial=self.initial_ke,
+                    spring_final=self.sim.state.cut_spring_ke.detach().cpu().numpy(),
+                    triangles=np.asarray(self.sim.builder.tri_indices),
+                )
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--config", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--parameters")
+    args = parser.parse_args(rospy.myargv()[1:])
+    rospy.init_node("public_disect_bridge")
+    bridge = PublicBridge(args.config, args.output, args.parameters)
+    rospy.spin()
