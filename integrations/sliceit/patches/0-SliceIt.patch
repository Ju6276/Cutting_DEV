+import json, pathlib, yaml, importlib.util
+import numpy as np
+import rospy, tf
+from ur_control import transformations
+root=pathlib.Path("/dataHDD/dong/Projects/SliceIt")
+rospy.init_node("align_public_scene", anonymous=True)
+listener=tf.TransformListener()
+listener.waitForTransform("cutting_board_disect","b_bot_base_link",rospy.Time(0),rospy.Duration(20))
+translation,quaternion=listener.lookupTransform("cutting_board_disect","b_bot_base_link",rospy.Time(0))
+matrix=transformations.quaternion_matrix(quaternion)
+matrix[:3,3]=translation
+source=root/"underlay_ws/src/ur_python_utilities/ur3e_rl/config/simulation/slicing_3d_disect.yaml"
+env=yaml.safe_load(source.read_text())
+scene=json.loads((root/"configs/public_prism.json").read_text())
+settings=env["ur3e_gym"]
+initial_pose=transformations.transform_pose(settings["target_pose"], settings["reset_motion"], rotated_frame=False)
+current=(matrix @ np.r_[initial_pose[:3],1])[1]
+# Existing SliceIt reset subtracts 4.3 mm before adding half the blade height.
+spec=importlib.util.spec_from_file_location("scene_knife", root/"disect/disect/cutting/knife.py")
+knife_module=importlib.util.module_from_spec(spec)
+spec.loader.exec_module(knife_module)
+knife=knife_module.Knife(getattr(knife_module.KnifeType, scene["knife_type"].upper()))
+desired=scene["initial_y"]-knife.spine_height/2+0.0043
+old=settings["reset_motion"][2]
+settings["reset_motion"][2] += float((desired-current)/matrix[1,2])
+(root/"configs/public_prism_ros.yaml").write_text(yaml.safe_dump(env,sort_keys=False))
+report={"robot_reset_z_original":old,"robot_reset_z_public":settings["reset_motion"][2],"disect_knife_origin_y_original":float(current),"disect_knife_origin_y_public":desired,"matrix":matrix.tolist(),"training_config_source":str(source)}
+(root/"runs/public_aligned/alignment.json").write_text(json.dumps(report,indent=2)+"\n")
+original=yaml.safe_load(source.read_text())
+original["ur3e_gym"]["reset_motion"][2]=settings["reset_motion"][2]
+assert original==env
+print(json.dumps(report))
