+#!/usr/bin/env python3
+"""Compile and run the source FDCC memory/restart regression on an isolated ROS master."""
+import argparse
+import json
+import os
+from pathlib import Path
+import shlex
+import signal
+import socket
+import subprocess
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--output', required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    output = Path(args.output).resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    executable = output / 'native_fdcc_state'
+    flags = shlex.split(subprocess.check_output(
+        ['pkg-config', '--cflags', '--libs', 'cartesian_controller_base'], text=True))
+    build = ['g++', '-std=c++17', '-O2', str(root / 'tests/native_fdcc_state.cpp'),
+             '-I/usr/include/eigen3', '-o', str(executable)] + flags + ['-lik_solvers']
+    subprocess.run(build, check=True, timeout=120)
+    with socket.socket() as sock:
+        sock.bind(('127.0.0.1', 0))
+        port = sock.getsockname()[1]
+    env = dict(os.environ, ROS_MASTER_URI='http://127.0.0.1:%d' % port,
+               ROS_HOME=str(output / 'ros_home'), ROS_LOG_DIR=str(output / 'ros_logs'))
+    with (output / 'roscore.log').open('w') as log:
+        master = subprocess.Popen(['roscore', '-p', str(port)], env=env, stdout=log,
+                                  stderr=subprocess.STDOUT, start_new_session=True)
+        try:
+            deadline = time.monotonic() + 30
+            while time.monotonic() < deadline:
+                probe = subprocess.run(['rosparam', 'list'], env=env, capture_output=True, timeout=5)
+                if probe.returncode == 0:
+                    break
+                if master.poll() is not None:
+                    raise RuntimeError('Isolated ROS master exited')
+                time.sleep(.1)
+            else:
+                raise TimeoutError('Isolated ROS master did not start')
+            run = subprocess.run([str(executable)], env=env, capture_output=True, text=True, timeout=30)
+            (output / 'solver.log').write_text(run.stdout + run.stderr)
+            run.check_returncode()
+            metrics = json.loads(next(line for line in run.stdout.splitlines() if line.startswith('{')))
+            def revision(directory):
+                commit = subprocess.check_output(['git', '-C', str(directory), 'rev-parse', 'HEAD'], text=True).strip()
+                dirty = bool(subprocess.check_output(['git', '-C', str(directory), 'status', '--porcelain'], text=True))
+                return {'commit': commit, 'dirty': dirty}
+            metrics['git'] = revision(root)
+            metrics['solver_git'] = revision(root / 'underlay_ws/src/cartesian_controllers')
+            (output / 'report.json').write_text(json.dumps(metrics, indent=2) + '\n')
+            print(json.dumps(metrics))
+        finally:
+            os.killpg(master.pid, signal.SIGINT)
+            try:
+                master.wait(timeout=10)
+            except subprocess.TimeoutExpired:
+                os.killpg(master.pid, signal.SIGKILL)
+                master.wait()
+
+
+if __name__ == '__main__':
+    main()
