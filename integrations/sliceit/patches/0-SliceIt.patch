+"""Cross-package state, temporal-axis and replay contracts for the slicing task."""
+import types
+import unittest
+from unittest.mock import patch
+
+import numpy as np
+import tensorflow as tf
+
+from tf2rl.algos.sac import SAC
+from tf2rl.policies.tfp_wave_actor import WaveFTActor
+from ur3e_openai.robot_env import RobotGazeboEnv
+from ur3e_openai.peg_gazebo_connection import GazeboConnection
+from ur3e_openai.task_envs.ur3e_force_control import UR3eForceControlEnv
+from ur3e_openai import cost_utils
+
+
+class FixedActor:
+    def __call__(self, states):
+        return tf.zeros((tf.shape(states)[0], 1)), tf.zeros((tf.shape(states)[0],))
+
+
+class StateValue:
+    def __call__(self, states, actions):
+        return states[:, 0]
+
+
+class CaptureHistory(tf.keras.layers.Layer):
+    def call(self, inputs):
+        self.seen = inputs.numpy().copy()
+        return tf.zeros((tf.shape(inputs)[0], 32))
+
+
+class SACInterfaces(unittest.TestCase):
+    def test_td_error_matches_independent_transitions(self):
+        agent = SAC(state_shape=(1,), action_dim=1, gpu=-1)
+        agent.actor = FixedActor()
+        agent.qf1 = StateValue()
+        agent.qf1_target = StateValue()
+        agent.qf2_target = StateValue()
+        for batch in (1, 3):
+            states = np.array([[0.], [5.], [7.]], np.float32)[:batch]
+            next_states = np.array([[10.], [20.], [30.]], np.float32)[:batch]
+            actions = np.zeros((batch, 1), np.float32)
+            rewards = np.array([1., 2., 3.], np.float32)[:batch]
+            dones = np.array([0., 1., 0.], np.float32)[:batch]
+            expected = np.array([1 + agent.discount * 10, -3, 3 + agent.discount * 30 - 7])[:batch]
+            for columns in (False, True):
+                r = rewards[:, None] if columns else rewards
+                d = dones[:, None] if columns else dones
+                for tensor in (False, True):
+                    args = (states, actions, next_states, r, d)
+                    if tensor:
+                        args = tuple(tf.constant(x) for x in args)
+                    result = agent.compute_td_error(*args)
+                    self.assertEqual(result.shape, (batch,))
+                    np.testing.assert_allclose(result, expected, rtol=1e-6)
+
+    def test_reset_observation_uses_restored_state(self):
+        env = types.SimpleNamespace(position=9., use_step_control=False, _update_episode=lambda: None,
+                                    _init_env_variables=lambda: None)
+        env._reset_sim = lambda: setattr(env, 'position', 2.)
+        env._get_obs = lambda: np.array([env.position])
+        np.testing.assert_array_equal(RobotGazeboEnv.reset(env), [2.])
+
+    def test_base_environment_reads_step_mode_parameter(self):
+        for stepped in (False, True):
+            env = types.SimpleNamespace(seed=lambda seed: None, pause_callback=lambda msg: None)
+            with patch('rospy.get_param', return_value=stepped) as parameter, \
+                    patch('rospy.Subscriber'), \
+                    patch('ur3e_openai.robot_env.ControllersConnection'):
+                RobotGazeboEnv.__init__(env, robot_name_space='b_bot', reset_controls=False)
+            parameter.assert_called_once_with('/ur3e_gym/use_step_control', False)
+            self.assertIs(env.use_step_control, stepped)
+
+    def test_reset_pauses_stepped_physics_before_observation(self):
+        for stepped in (False, True):
+            events = []
+            env = types.SimpleNamespace(
+                use_step_control=stepped, _update_episode=lambda: None,
+                _init_env_variables=lambda: None,
+                _reset_sim=lambda: events.append('reset'),
+                robot_connection=types.SimpleNamespace(pause=lambda: events.append('pause')),
+                _get_obs=lambda: events.append('observation'))
+            RobotGazeboEnv.reset(env)
+            expected = ['reset', 'pause', 'observation'] if stepped else ['reset', 'observation']
+            self.assertEqual(events, expected)
+
+    def test_pause_calls_synchronous_physics_service_without_advancing(self):
+        calls = []
+        connection = types.SimpleNamespace(
+            pause_serv=lambda: calls.append('pause_physics'),
+            step_simulation_serv=lambda request: calls.append('step'))
+        with patch('rospy.wait_for_service') as wait:
+            GazeboConnection.pause(connection)
+        wait.assert_called_once_with('/gazebo/pause_physics')
+        self.assertEqual(calls, ['pause_physics'])
+
+    def test_reset_unpause_then_pause_uses_ordered_physics_services(self):
+        calls = []
+        connection = types.SimpleNamespace(
+            unpause_serv=lambda: calls.append('unpause_physics'),
+            pause_serv=lambda: calls.append('pause_physics'),
+            step_simulation_serv=lambda request: calls.append('step'))
+        with patch('rospy.wait_for_service'):
+            GazeboConnection.unpause(connection)
+            GazeboConnection.pause(connection)
+        self.assertEqual(calls, ['unpause_physics', 'pause_physics'])
+
+    def test_derivatives_restart_at_new_episode_pose(self):
+        pose = np.array([.1, .2, .3, 0., 0., 0., 1.])
+        env = types.SimpleNamespace(_log=lambda: None, n_actions=6,
+            previous_ee_pose=np.array([9., 9., 9., 0., 0., 0., 1.]),
+            previous_velocity=np.ones(6), previous_acceleration=np.ones(6),
+            ur3e_arm=types.SimpleNamespace(end_effector=lambda: pose.copy()),
+            agent_control_dt=.05, current_target_pose=pose.copy(), target_dims=[0, 2, 4])
+        UR3eForceControlEnv._init_env_variables(env)
+        result = UR3eForceControlEnv.get_end_effector_relative_position_and_velocity(env)
+        for value in result:
+            np.testing.assert_allclose(value, 0., atol=1e-14)
+        pose[0] += .01
+        _, velocity, acceleration, jerk = UR3eForceControlEnv.get_end_effector_relative_position_and_velocity(env)
+        np.testing.assert_allclose(velocity, [.2, 0, 0], atol=1e-12)
+        np.testing.assert_allclose(acceleration, [4, 0, 0], atol=1e-12)
+        np.testing.assert_allclose(jerk, [80, 0, 0], atol=1e-10)
+
+    def history_environment(self):
+        # Four time samples and three selected components avoid square-axis ambiguity.
+        history = np.array([[1., 8., 2., 9., .1, 7.], [2., 8., 4., 9., .2, 7.],
+                            [3., 8., 6., 9., .3, 7.], [4., 8., 8., 9., .4, 7.]])
+        limits = np.array([50., 50., 50., 10., 10., 10.])
+        env = types.SimpleNamespace(target_dims=[0, 2, 4], wrench_hist_size=4,
+            controller=types.SimpleNamespace(max_force_torque=limits),
+            ur3e_arm=types.SimpleNamespace(get_ee_wrench_hist=lambda n: history.copy()),
+            get_end_effector_relative_position_and_velocity=lambda: tuple(np.zeros(3) for _ in range(4)),
+            max_distance=np.ones(3), normalize_velocity=False, last_action_as_obs=True,
+            last_actions=np.zeros(6), jerkiness_as_obs=True, ft_hist=True, use_dynamic_rewards=False,
+            action_result=None, cost_collision=-100., cost_done=100., cost_step=-1.,
+            goal_reached=False, w_dist=1., w_force=1., w_jerkiness=1., total_steps=0,
+            cumulated_dist=0., cumulated_force=0., cumulated_jerk=0.)
+        obs = UR3eForceControlEnv._get_obs(env)
+        return env, obs, history[:, [0, 2, 4]], limits[[0, 2, 4]]
+
+    def test_reward_recovers_component_means(self):
+        env, obs, history, _ = self.history_environment()
+        reward, terms = cost_utils.slicing(env, obs, False)
+        norm = np.linalg.norm([2.5, 5., .25])
+        expected_force_reward = -1 / (1 + np.exp(-norm / 2 + 3))
+        self.assertAlmostEqual(env.cumulated_force, norm)
+        self.assertAlmostEqual(terms[1], expected_force_reward)
+        self.assertAlmostEqual(reward, (expected_force_reward - 1) / 4)
+
+    def test_actor_receives_actual_time_samples(self):
+        _, obs, history, limits = self.history_environment()
+        def param(name, default=None):
+            return {'ur3e_gym/wrench_hist_size': 4, 'ur3e_gym/target_dims': [0, 2, 4]}.get(name, default)
+        with patch('rospy.get_param', side_effect=param):
+            actor = WaveFTActor(state_shape=(len(obs),), action_dim=6, max_action=1.)
+        capture = CaptureHistory()
+        actor.ft_net = capture
+        actor._compute_dist(tf.constant(np.stack([obs, obs]), dtype=tf.float32))
+        expected = history / limits
+        np.testing.assert_allclose(capture.seen, np.stack([expected, expected]), rtol=1e-6)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_shutdown_hook.py b/tests/test_shutdown_hook.py
new file mode 100644
index 0000000..2f66fbd
--- /dev/null
+++ b/tests/test_shutdown_hook.py
@@ -0,0 +1,127 @@
+"""ROS shutdown controller switching must have a wall-time bound."""
+import subprocess
+import sys
+import textwrap
+import threading
+import time
+
+import rospy
+import pytest
+
+from ur_control.fzi_cartesian_compliance_controller import CompliantController
+
+
+def controller(callback):
+    arm = CompliantController.__new__(CompliantController)
+    arm.activate_joint_trajectory_controller = callback
+    return arm
+
+
+def test_shutdown_preserves_normal_controller_activation():
+    calls = []
+    arm = controller(lambda: calls.append('activate') or True)
+    result = arm._shutdown_controller(timeout=.1)
+    assert calls == ['activate']
+    assert result['state'] == 'ok'
+    assert arm.shutdown_result == result
+
+
+def test_shutdown_logs_switch_exception_without_raising(monkeypatch):
+    errors = []
+    monkeypatch.setattr(rospy, 'logerr', lambda *args: errors.append(args))
+    def fail():
+        raise RuntimeError('controller service disappeared')
+    arm = controller(fail)
+    result = arm._shutdown_controller(timeout=.1)
+    assert result['state'] == 'error'
+    assert arm.shutdown_result == result
+    assert errors
+    assert 'controller service disappeared' in repr(errors)
+
+
+def test_shutdown_does_not_wait_forever_for_controller_switch(monkeypatch):
+    errors = []
+    release = threading.Event()
+    entered = threading.Event()
+    monkeypatch.setattr(rospy, 'logerr', lambda *args: errors.append(args))
+    def block():
+        assert threading.current_thread().daemon
+        entered.set()
+        release.wait()
+    started = time.monotonic()
+    try:
+        arm = controller(block)
+        result = arm._shutdown_controller(timeout=.03)
+        assert result['state'] == 'timeout'
+        assert arm.shutdown_result == result
+        assert entered.is_set()
+        assert time.monotonic() - started < .5
+        assert errors
+    finally:
+        release.set()
+
+
+def test_real_rospy_atexit_exits_when_controller_service_never_returns():
+    code = textwrap.dedent("""
+        import threading
+        import rospy
+        from ur_control.fzi_cartesian_compliance_controller import CompliantController
+        arm = CompliantController.__new__(CompliantController)
+        def block():
+            print('SHUTDOWN_CALLBACK_ENTERED', flush=True)
+            threading.Event().wait()
+        arm.activate_joint_trajectory_controller = block
+        rospy.on_shutdown(lambda: arm._shutdown_controller(timeout=.05))
+        print('MAIN_RETURNED', flush=True)
+    """)
+    result = subprocess.run([sys.executable, '-c', code], capture_output=True,
+                            text=True, timeout=5.)
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert 'MAIN_RETURNED' in result.stdout
+    assert 'SHUTDOWN_CALLBACK_ENTERED' in result.stdout
+
+
+@pytest.mark.parametrize('failed_result', [False, None])
+def test_shutdown_reports_service_rejection_even_when_switch_does_not_raise(monkeypatch, failed_result):
+    errors = []
+    monkeypatch.setattr(rospy, 'logerr', lambda *args: errors.append(args))
+    arm = controller(lambda: failed_result)
+    result = arm._shutdown_controller(timeout=.1)
+    assert result['state'] == 'error'
+    assert arm.shutdown_result == result
+    assert errors
+
+
+def test_shutdown_unpause_uses_bounded_service_discovery_and_calls_rpc(monkeypatch):
+    from ur3e_openai.peg_gazebo_connection import GazeboConnection
+    calls = []
+    monkeypatch.setattr(rospy, 'wait_for_service',
+                        lambda name, timeout: calls.append(('wait', name, timeout)))
+    connection = GazeboConnection.__new__(GazeboConnection)
+    connection.unpause_serv = lambda: calls.append(('rpc',))
+    connection.unpause_for_shutdown(timeout=.1)
+    assert calls == [('wait', '/gazebo/unpause_physics', .1), ('rpc',)]
+
+
+def test_shutdown_unpause_propagates_discovery_failure_without_calling_rpc(monkeypatch):
+    from ur3e_openai.peg_gazebo_connection import GazeboConnection
+    calls = []
+    def unavailable(name, timeout):
+        raise rospy.ROSException('unpause service unavailable')
+    monkeypatch.setattr(rospy, 'wait_for_service', unavailable)
+    connection = GazeboConnection.__new__(GazeboConnection)
+    connection.unpause_serv = lambda: calls.append('rpc')
+    with pytest.raises(rospy.ROSException, match='unpause service unavailable'):
+        connection.unpause_for_shutdown(timeout=.1)
+    assert calls == []
+
+
+def test_shutdown_unpause_propagates_rpc_service_exception(monkeypatch):
+    from ur3e_openai.peg_gazebo_connection import GazeboConnection
+    monkeypatch.setattr(rospy, 'wait_for_service', lambda name, timeout: None)
+    connection = GazeboConnection.__new__(GazeboConnection)
+    def fail():
+        raise rospy.ServiceException('unpause RPC disconnected')
+    connection.unpause_serv = fail
+    with pytest.raises(rospy.ServiceException, match='unpause RPC disconnected'):
+        connection.unpause_for_shutdown(timeout=.1)
diff --git a/tests/test_stepped_duration.py b/tests/test_stepped_duration.py
new file mode 100644
index 0000000..f92e9ca
--- /dev/null
+++ b/tests/test_stepped_duration.py
@@ -0,0 +1,60 @@
+"""Control duration uses completed server intervals despite delayed ROS clock delivery."""
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import numpy as np
+import pytest
+import rospy
+
+from ur_control.fzi_cartesian_compliance_controller import CompliantController
+
+
+def controller():
+    calls = []
+    targets = []
+    state = {'time_ns': 19507000000}
+    def step(request):
+        before = state['time_ns']
+        state['time_ns'] += request.steps * 1000000
+        calls.append(request.steps)
+        return SimpleNamespace(success=True,
+            start_time=rospy.Time(before // 1000000000, before % 1000000000),
+            end_time=rospy.Time(state['time_ns'] // 1000000000, state['time_ns'] % 1000000000),
+            joint_state=SimpleNamespace(), joint_is_angular=[])
+    arm = SimpleNamespace(use_step_control=True, auto_switch_controllers=False,
+        set_cartesian_target_wrench=lambda value: None,
+        set_cartesian_target_pose=lambda value: targets.append((len(calls), value.copy())),
+        get_ee_wrench=lambda **kwargs: np.zeros(6), step_simulation_serv=step,
+        joint_traj_controller=SimpleNamespace(valid_joint_names=['joint'],
+            install_step_joint_state=lambda *args: None),
+        compute_disect_knife_pose=lambda: (np.zeros(7), np.zeros(6)),
+        publish_odom=lambda *args, **kwargs: None, disect_step_sim=lambda: None)
+    arm.advance_gazebo = lambda steps: CompliantController.advance_gazebo(arm, steps)
+    return arm, calls, targets
+
+
+@pytest.mark.parametrize('duration, expected_steps', [(.05, 25), (.1, 50)])
+def test_step_duration_ignores_frozen_or_delayed_client_clock(duration, expected_steps):
+    arm, calls, _ = controller()
+    with patch('rospy.get_time', return_value=19.505), patch('rospy.is_shutdown', side_effect=lambda: len(calls) > 100):
+        CompliantController.execute_compliance_control(arm, trajectory=np.zeros(7),
+            target_wrench=np.zeros(6), max_force_torque=np.ones(6), duration=duration, auto_stop=False)
+    assert calls == [2] * expected_steps
+
+
+def test_trajectory_segment_retains_strict_greater_than_source_boundary():
+    arm, calls, targets = controller()
+    with patch('rospy.get_time', return_value=19.505), patch('rospy.is_shutdown', side_effect=lambda: len(calls) > 100):
+        CompliantController.execute_compliance_control(arm, trajectory=np.arange(14.).reshape(2, 7),
+            target_wrench=np.zeros(6), max_force_torque=np.ones(6), duration=.1, auto_stop=False)
+    assert calls == [2] * 50
+    assert [tick for tick, _ in targets] == [0, 26]
+
+
+def test_force_termination_still_prevents_any_physics_step():
+    arm, calls, _ = controller()
+    arm.get_ee_wrench = lambda **kwargs: np.full(6, 2.)
+    with patch('rospy.get_time', return_value=19.505), patch('rospy.is_shutdown', return_value=False):
+        CompliantController.execute_compliance_control(arm, trajectory=np.zeros(7),
+            target_wrench=np.zeros(6), max_force_torque=np.ones(6), duration=.05, auto_stop=False)
+    assert calls == []
