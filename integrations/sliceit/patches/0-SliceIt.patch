@@ -0,0 +1,60 @@
+#include <cartesian_controller_base/ForwardDynamicsSolver.h>
+#include <hardware_interface/joint_command_interface.h>
+#include <ros/ros.h>
+#include <cmath>
+#include <iomanip>
+#include <iostream>
+
+class InspectableSolver : public cartesian_controller_base::ForwardDynamicsSolver
+{
+public:
+  void restore(double position, double velocity)
+  {
+    m_current_positions(0) = m_last_positions(0) = position;
+    m_current_velocities(0) = m_last_velocities(0) = velocity;
+    updateKinematics();
+  }
+};
+
+int main(int argc, char** argv)
+{
+  ros::init(argc, argv, "native_fdcc_state_regression");
+  ros::NodeHandle first_node("first"), second_node("second");
+  KDL::Chain chain;
+  chain.addSegment(KDL::Segment("tip", KDL::Joint("joint", KDL::Joint::RotZ),
+    KDL::Frame(KDL::Vector(1., 0., 0.)),
+    KDL::RigidBodyInertia(1., KDL::Vector::Zero(), KDL::RotationalInertia(1., 1., 1.))));
+  KDL::JntArray upper(1), lower(1);
+  upper(0) = 10.;
+  lower(0) = -10.;
+  InspectableSolver first, second;
+  if (!first.init(first_node, chain, upper, lower) || !second.init(second_node, chain, upper, lower))
+    return 2;
+  double position = .3, measured_velocity = -.07, effort = 0., command = 0.;
+  hardware_interface::JointStateHandle state("joint", &position, &measured_velocity, &effort);
+  std::vector<hardware_interface::JointHandle> handles{hardware_interface::JointHandle(state, &command)};
+  first.setStartState(handles);
+  second.setStartState(handles);
+  first.restore(position, .1);
+  second.restore(position, .6);
+  first.synchronizeJointPositions(handles);
+  second.synchronizeJointPositions(handles);
+  const auto force = ctrl::Vector6D::Zero();
+  const auto a = first.getJointControlCmds(ros::Duration(.02), force);
+  const auto b = second.getJointControlCmds(ros::Duration(.02), force);
+  const double displacement = b.positions[0] - a.positions[0];
+  const double velocity = b.velocities[0] - a.velocities[0];
+  const double equation_error = std::max(std::abs(displacement - .01), std::abs(velocity - .45));
+  second.restore(a.positions[0], a.velocities[0]);
+  first.synchronizeJointPositions(handles);
+  second.synchronizeJointPositions(handles);
+  const auto continued = first.getJointControlCmds(ros::Duration(.02), force);
+  const auto restarted = second.getJointControlCmds(ros::Duration(.02), force);
+  const double restart_error = std::max(std::abs(continued.positions[0] - restarted.positions[0]),
+                                        std::abs(continued.velocities[0] - restarted.velocities[0]));
+  std::cout << std::setprecision(17) << "{\"measured_q\":" << position
+    << ",\"measured_qd\":" << measured_velocity << ",\"internal_velocity_difference\":0.5"
+    << ",\"command_difference\":" << displacement << ",\"next_velocity_difference\":" << velocity
+    << ",\"equation_max_error\":" << equation_error << ",\"restart_max_error\":" << restart_error << "}" << std::endl;
+  return (equation_error < 1e-13 && restart_error < 1e-13) ? 0 : 1;
+}
