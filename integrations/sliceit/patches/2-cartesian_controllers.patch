+
+template <class HardwareInterface>
+void CartesianComplianceController<HardwareInterface>::publishRecurrentState(const ros::Time& time)
+{
+  ++m_recurrent_sequence;
+  std::unique_lock<std::mutex> lock(m_recurrent_mutex, std::try_to_lock);
+  if (!lock.owns_lock())
+    return;
+  auto& data = m_recurrent_snapshot;
+  data[0] = 1;
+  data[1] = m_recurrent_sequence;
+  data[2] = time.toSec();
+  const auto& q = Base::m_ik_solver->getPositions();
+  const auto& v = Base::m_ik_solver->getVelocities();
+  const auto error = Base::getPreviousError();
+  const size_t joints = Base::m_joint_handles.size();
+  data[3] = joints;
+  for (size_t i = 0; i < joints; ++i)
+  {
+    data[4 + i] = Base::m_joint_handles[i].getPosition();
+    data[4 + joints + i] = Base::m_joint_handles[i].getVelocity();
+    data[4 + 2 * joints + i] = q(i);
+    data[4 + 3 * joints + i] = v(i);
+    data[4 + 4 * joints + i] = m_previous_position_command[i];
+  }
+  for (size_t i = 0; i < 6; ++i)
+  {
+    data[4 + 5 * joints + i] = error[i];
+  }
+  auto copy_pose = [&data](const KDL::Frame& pose, size_t offset) {
+    for (size_t i = 0; i < 3; ++i)
+      data[offset + i] = pose.p[i];
+    pose.M.GetQuaternion(data[offset + 3], data[offset + 4], data[offset + 5], data[offset + 6]);
+  };
+  copy_pose(Base::m_ik_solver->getEndEffectorPose(), 10 + 5 * joints);
+
+  data[42 + 5 * joints] = m_recurrent_command_valid;
+  data[43 + 5 * joints] = time.toSec();
+  m_recurrent_available = true;
+}
+
+template <class HardwareInterface>
+bool CartesianComplianceController<HardwareInterface>::captureRecurrentState(
+    std_srvs::Trigger::Request&, std_srvs::Trigger::Response& response)
+{
+  std::vector<double> data;
+  {
+    std::lock_guard<std::mutex> lock(m_recurrent_mutex);
+    if (!m_recurrent_available)
+    {
+      response.success = false;
+      response.message = "The controller has not completed an update";
+      return true;
+    }
+    data = m_recurrent_snapshot;
+    const size_t joints = Base::m_joint_handles.size();
+    // Call after stepped Gazebo has returned: writeSim has saturated these commands.
+    for (size_t i = 0; i < joints; ++i)
+      data[4 + 4 * joints + i] = Base::m_joint_handles[i].getCommand();
+    const auto target = MotionBase::getTargetFrameSnapshot();
+    const size_t pose_offset = 17 + 5 * joints;
+    for (size_t i = 0; i < 3; ++i)
+      data[pose_offset + i] = target.p[i];
+    target.M.GetQuaternion(data[pose_offset + 3], data[pose_offset + 4],
+                           data[pose_offset + 5], data[pose_offset + 6]);
+    ForceBase::copyForceState(data, 24 + 5 * joints);
+    data[43 + 5 * joints] = ros::Time::now().toSec();
+  }
+  std::ostringstream output;
+  output << std::setprecision(std::numeric_limits<double>::max_digits10) << "[";
+  for (size_t i = 0; i < data.size(); ++i)
+  {
+    if (i)
+      output << ",";
+    output << data[i];
+  }
+  output << "]";
+  response.success = true;
+  response.message = output.str();
+  return true;
 }
 
